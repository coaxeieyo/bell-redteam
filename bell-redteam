# candidate wordlists
# --------------------------------------------------------------------------


def derived_candidates(
    entries: Sequence[HashEntry], prefix: str, cfg: Optional[Config] = None
) -> List[str]:
    """SSID-derived candidates: the ESSID itself and close variants.

    ISP routers frequently ship the SSID (or a direct derivative of it) as
    the WiFi passphrase, so this list is worth far more than raw brute force.
    Candidates shorter than PSK_MIN_LEN are dropped: WPA-PSK is 8..63
    characters and hashcat's WPA kernels refuse anything shorter.
    """
    out: List[str] = []
    seen = set()
    dropped = 0

    def add(value: str) -> None:
        nonlocal dropped
        if not value:
            return
        if len(value) < PSK_MIN_LEN:
            dropped += 1
            return
        if value not in seen:
            seen.add(value)
            out.append(value)

    ordered_entries = sorted(
        entries, key=lambda e: (not is_preferred(e.essid, cfg), e.essid)
    ) if cfg is not None else list(entries)
    for entry in ordered_entries:
        essid = entry.essid
        stripped = essid[len(prefix) :] if essid.startswith(prefix) else essid
        variants = [
            essid,
            essid.upper(),
            essid.lower(),
            essid.capitalize(),
            essid.swapcase(),
            stripped,
            stripped.upper(),
            stripped.lower(),
            stripped.capitalize(),
            stripped.swapcase(),
            essid.replace("-", ""),
            essid.replace("-", "").upper(),
            essid.replace("_", ""),
            essid.replace(" ", ""),
        ]
        for mac in (entry.bssid, entry.sta):
            if mac and len(mac) == 12:
                tail = mac[-8:]
                variants.append(f"{prefix}{tail}")
                variants.append(f"{prefix}{tail}".upper())
        for variant in variants:
            add(variant)
    return out


def build_candidate_wordlists(
    entries: Sequence[HashEntry],
    cfg: Config,
    workdir: Path,
    pcapng: Optional[Path],
    log: Log,
) -> Dict[str, Optional[Path]]:
    """Build the derived/wordlist candidates using the official hcxtools."""
    prefix = str(cfg.get("ssid_prefix") or "BELL")
    cand_dir = workdir / "candidates"
    cand_dir.mkdir(parents=True, exist_ok=True)
    out: Dict[str, Optional[Path]] = {"derived": None, "hcxeiutool": None,
                                      "hcxpsktool": None, "wordlist": None}

    derived = derived_candidates(entries, prefix, cfg)
    derived, _ = filter_anti_candidates(derived, log)
    if derived:
        path = cand_dir / "derived.txt"
        path.write_text("\n".join(derived) + "\n", encoding="utf-8")
        out["derived"] = path
        log(f"candidates: {len(derived)} SSID-derived candidates -> {path}")

    # Rule expansion: hashcat applies the official rule file to the derived
    # base, exactly as the hcxtools documentation shows
    # ("hashcat --stdout -r <rule> charlist"). The result is filtered with
    # the same anti-candidate rules before it is cracked.
    rule_file = str(cfg.get("rule_file") or "")
    if (cfg.get("use_rules", True) and rule_file and derived
            and Path(rule_file).exists()):
        base = cand_dir / "rule_base.txt"
        base.write_text("\n".join(derived) + "\n", encoding="utf-8")
        # Use --force (CPU backend) to avoid broken OpenCL drivers that
        # raise CL_INVALID_VALUE on some setups.
        proc = run(
            ["hashcat", "--stdout", "--force", "-r", rule_file, str(base)],
            timeout=300,
        )
        if not (proc.returncode == 0 and proc.stdout.strip()):
            proc = run(
                ["hashcat", "--stdout", "-r", rule_file, str(base)],
                timeout=300,
            )
        if proc.returncode == 0 and proc.stdout.strip():
            expanded = [line for line in proc.stdout.splitlines() if line.strip()]
            expanded, _ = filter_anti_candidates(expanded, log)
            if expanded:
                path = cand_dir / "rules.txt"
                path.write_text("\n".join(expanded) + "\n", encoding="utf-8")
                out["rules"] = path
                log(f"candidates: {len(expanded)} rule-expanded candidates -> "
                    f"{path}")
        else:
            log(f"candidates: rule expansion failed: "
                f"{proc.stderr.strip()[:120]}", "warn")

    # hcxeiutool derives digit / hex-digit / character / character-sequence
    # patterns from the ESSIDs. The official workflow feeds it the -E output
    # of hcxpcapngtool, which is autohex "$HEX[...]" and is skipped by
    # hcxeiutool; plain ESSIDs are used here so the pattern extraction
    # actually sees the characters.
    essid_list = cand_dir / "essids.txt"
    essids = sorted({e.essid for e in entries})
    essid_list.write_text("\n".join(essids) + "\n", encoding="utf-8")

    if cfg.get("use_hcxeiutool") and have("hcxeiutool") and entries:
        digit = cand_dir / "hcx_digit.txt"
        xdigit = cand_dir / "hcx_xdigit.txt"
        chars = cand_dir / "hcx_chars.txt"
        sclist = cand_dir / "hcx_sclist.txt"
        # hcxeiutool opens its outputs in append mode, so stale content
        # would accumulate between runs.
        for stale in (digit, xdigit, chars, sclist):
            try:
                stale.unlink()
            except OSError:
                pass
        proc = run(
            [
                "hcxeiutool",
                "-i",
                str(essid_list),
                "-d",
                str(digit),
                "-x",
                str(xdigit),
                "-c",
                str(chars),
                "-s",
                str(sclist),
            ],
            timeout=120,
        )
        if proc.returncode == 0:
            merged = cand_dir / "hcxeiutool.txt"
            parts = [digit, xdigit, chars, sclist]
            with merged.open("w", encoding="utf-8") as out_fh:
                for part in parts:
                    if not part.exists():
                        continue
                    out_fh.write(part.read_text(encoding="utf-8", errors="replace"))
                    out_fh.write("\n")
            # sort -u, like the official workflow. The raw ESSID list is
            # deliberately not merged in: hashcat's autohex would turn an
            # all-hex ESSID such as "BEEF" into raw bytes.
            unique = sorted(set(read_lines_text(merged)))
            merged.write_text("\n".join(unique) + "\n", encoding="utf-8")
            out["hcxeiutool"] = merged
            log(f"candidates: hcxeiutool wordlist -> {merged}")
        else:
            log(f"candidates: hcxeiutool failed: {proc.stderr.strip()[:160]}",
                "warn")

    if cfg.get("use_hcxpsktool") and have("hcxpsktool") and entries:
        psk = cand_dir / "hcxpsktool.txt"
        hashes = cfg.get("_bell_hashes") or str(workdir / "bell.22000")
        try:
            psk.unlink()
        except OSError:
            pass
        for entry in entries:
            # hcxpsktool reads the hc22000 hash file (-c), not the capture
            cmd = ["hcxpsktool", "-c", str(hashes), "-e", entry.essid]
            if entry.bssid:
                cmd += ["-b", entry.bssid.replace(":", "")]
            cmd += ["-o", str(psk)]
            if not cfg.get("hcxpsktool_full"):
                # the complete weak-PSK list is ~140 MB and takes a minute;
                # the access point MAC derived subset is what matters here
                cmd.append("--maconly")
            proc = run(cmd, timeout=300)
            if proc.returncode != 0:
                log(f"candidates: hcxpsktool failed: {proc.stderr.strip()[:120]}",
                    "warn")
                break
        if psk.exists() and psk.stat().st_size:
            # the tool requires a sorted unique list
            unique = sorted(set(read_lines_text(psk)))
            psk.write_text("\n".join(unique) + "\n", encoding="utf-8")
            out["hcxpsktool"] = psk
            log(f"candidates: hcxpsktool weak-PSK list -> {psk} "
                f"({len(unique)} candidates)")

    wordlist = str(cfg.get("wordlist") or "")
    if wordlist and Path(wordlist).exists():
        out["wordlist"] = Path(wordlist)
    elif wordlist:
        alt = Path(wordlist + ".gz")
        if alt.exists():
            target = cand_dir / "wordlist.txt"
            if not target.exists():
                import gzip

                with gzip.open(alt, "rb") as src, target.open("wb") as dst:
                    while True:
                        chunk = src.read(1 << 20)
                        if not chunk:
                            break
                        dst.write(chunk)
            out["wordlist"] = target
            log(f"candidates: decompressed wordlist -> {target}")
    return out


