class TUI:
    """Interactive front end: interface picker, stealth prompts, guided run."""

    def __init__(self, state: RunState) -> None:
        self.state = state
        self.cfg = state.config
        self.screen = "intro"
        self.status = ""
        self.interfaces: List[WirelessIface] = []
        self.idx = 0
        self.thread: Optional[threading.Thread] = None
        self.workflow: Optional[Workflow] = None
        self.results_payload: Dict[str, Any] = {}

    # -- drawing helpers -------------------------------------------------
    def _put(self, stdscr, y: int, x: int, text: str, attr: int = 0) -> None:
        h, w = stdscr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        try:
            stdscr.addnstr(y, x, text, max(0, w - x - 1), attr)
        except curses.error:
            pass

    def _header(self, stdscr, title: str) -> int:
        h, w = stdscr.getmaxyx()
        try:
            stdscr.attron(curses.color_pair(5) | curses.A_BOLD)
            stdscr.addnstr(0, 0, f" {APP} {VERSION}  {title}".ljust(w - 1), w - 1)
            stdscr.attroff(curses.color_pair(5) | curses.A_BOLD)
        except curses.error:
            pass
        return 2

    def _footer(self, stdscr, keys: str) -> None:
        h, w = stdscr.getmaxyx()
        if h < 2:
            return
        try:
            stdscr.attron(curses.color_pair(5))
            stdscr.addnstr(h - 1, 0, " " + keys.ljust(w - 2)[: max(0, w - 2)],
                           max(0, w - 1))
            stdscr.attroff(curses.color_pair(5))
        except curses.error:
            pass

    def _init_colors(self) -> None:
        if not curses.has_colors():
            return
        curses.start_color()
        try:
            curses.use_default_colors()
        except curses.error:
            pass
        curses.init_pair(1, curses.COLOR_CYAN, -1)
        curses.init_pair(2, curses.COLOR_YELLOW, -1)
        curses.init_pair(3, curses.COLOR_GREEN, -1)
        curses.init_pair(4, curses.COLOR_RED, -1)
        curses.init_pair(5, curses.COLOR_WHITE, curses.COLOR_BLUE)
        curses.init_pair(6, curses.COLOR_MAGENTA, -1)

    # -- entry point -----------------------------------------------------
    def run(self, force_plain: bool = False) -> int:
        if force_plain:
            return self._plain()
        # ensure a usable terminal type for curses
        if not os.environ.get("TERM") or os.environ.get("TERM") == "dumb":
            os.environ["TERM"] = "xterm"
        if curses is None:
            sys.stderr.write("curses is not available; using plain mode\n")
            return self._plain()
        if not sys.stdout.isatty():
            return self._plain()
        # keep log output out of the terminal while curses owns the screen
        try:
            self.state.log.quiet = True
        except Exception:
            pass
        try:
            curses.wrapper(self._main)
        except curses.error as exc:
            sys.stderr.write(f"curses unavailable ({exc}); using plain mode\n")
            return self._plain()
        return 0

    def _main(self, stdscr) -> None:
        self._init_colors()
        curses.noecho()
        curses.cbreak()
        stdscr.keypad(True)
        stdscr.timeout(-1)
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        # the intro screen shows the toolchain, so check it before drawing
        self.state.preflight = Workflow(self.state).preflight()
        while self.screen not in ("quit",):
            if self.screen == "intro":
                self.screen = self._screen_intro(stdscr)
            elif self.screen == "interfaces":
                self.screen = self._screen_interfaces(stdscr)
            elif self.screen == "config":
                self.screen = self._screen_config(stdscr)
            elif self.screen == "targets":
                self.screen = self._screen_targets(stdscr)
            elif self.screen == "run":
                self.screen = self._screen_run(stdscr)
            elif self.screen == "results":
                self.screen = self._screen_results(stdscr)

    # -- screen: intro ---------------------------------------------------
    def _screen_intro(self, stdscr) -> str:
        while True:
            stdscr.erase()
            row = self._header(stdscr, "WiFi PMKID red-team workflow")
            info = self.state.preflight or {}
            tools = info.get("tools", {})
            missing = info.get("missing", [])
            lines = [
                "",
                "  Target      : BELL-series SSIDs matching "
                f"{self.cfg.get('essid_regex')}",
                "  Adapter     : "
                f"{self.cfg.get('interface') or '(none)'}  "
                f"driver={self.state.preflight.get('adapter_driver') or '?'}",
                "  Method      : PMKID capture (wifite / hcxdumptool) -> "
                "hcxpcapngtool -> hcxhashtool",
                "  Cracking    : hashcat -m 22000, alphanumeric mask chain "
                f"({self.cfg.get('mask_len')} chars, "
                f"{self.cfg.get('mask_charset')})",
                "",
                "  Toolchain:",
            ]
            for tool in TOOLS_REQUIRED:
                mark = "ok " if tools.get(tool) else "MISSING"
                lines.append(f"    [{mark}] {tool}")
            lines += [
                "",
                "  Authorized use only: a controlled lab environment where "
                "every",
                "  signal in range is in scope.",
                "",
            ]
            if missing:
                lines.append(f"  WARNING: missing {', '.join(missing)}")
                lines.append("")
            for i, line in enumerate(lines):
                attr = 0
                if "MISSING" in line or "WARNING" in line:
                    attr = curses.color_pair(4)
                elif line.strip().startswith("["):
                    attr = curses.color_pair(3)
                self._put(stdscr, row + i, 2, line, attr)
            self._footer(stdscr, "[Enter] continue    [q] quit")
            stdscr.refresh()
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return "quit"
            if key in (10, 13, curses.KEY_ENTER):
                self.state.preflight = Workflow(self.state).preflight()
                return "interfaces"

