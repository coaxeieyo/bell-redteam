def apply_overrides(cfg: Config, args: argparse.Namespace) -> None:
    # argument name -> configuration key
    mapping = {
        "interface": "interface",
        "essid_regex": "essid_regex",
        "mask_len": "mask_len",
        "mask_charset": "mask_charset",
        "mask_order": "mask_order",
        "backend": "capture_backend",
        "monitor_mode": "monitor_mode",
        "cores": "hashcat_cores",
        "max_hours": "max_hours_per_step",
        "speed": "hashcat_speed",
        "wordlist": "wordlist",
        "pmkid_timeout": "pmkid_timeout",
        "scan_seconds": "scan_seconds",
        "devices": "hashcat_device_ids",
    }
    for arg, key in mapping.items():
        value = getattr(args, arg, None)
        if value is not None:
            cfg.set(key, value)
    if args.allow_huge:
        cfg.set("allow_huge_keyspace", True)
    if args.deauth:
        cfg.set("allow_deauth", True)
    if args.random_mac:
        cfg.set("randomize_mac", True)


def print_plan(plan: Sequence[Step], speed: Optional[float]) -> None:
    print(f"{'step':<32} {'keyspace':>12} {'eta':>12}  detail")
    for step in plan:
        eta = human_time(step.est_seconds) if step.est_seconds else "-"
        flag = f" [SKIP: {step.skip_reason}]" if step.skip_reason else ""
        print(f"{step.name:<32} {human_count(step.keyspace):>12} {eta:>12}  "
              f"{step.desc}{flag}")
    if speed:
        print(f"\nassumed throughput: {speed:,.0f} H/s")


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = build_arg_parser().parse_args(argv)
    workdir = Path(args.workdir).expanduser()
    workdir.mkdir(parents=True, exist_ok=True)
    for sub in ("hs", "captures", "candidates", "logs", "results", "masks"):
        (workdir / sub).mkdir(parents=True, exist_ok=True)
    chown_to_real_user(workdir)

    if args.command == "selftest":
        return selftest(run_hashcat_check=not args.no_hashcat_check)

    if args.command == "deps":
        return check_deps()

    log = Log(workdir / "logs" / "bell-redteam.log")
    cfg = Config.load(workdir / "config.json")
    apply_overrides(cfg, args)
    cfg.save(workdir / "config.json")

    state = RunState(config=cfg, workdir=workdir, log=log)
    workflow = Workflow(state)

    # Auto-select a wireless interface when none is configured, so the user
    # never has to type a device name.  Ralink USB adapters are preferred,
    # then physical monitor-capable adapters, then anything else.
    if not cfg.get("interface"):
        chosen = preferred_interface(list_interfaces())
        if chosen:
            cfg.set("interface", chosen.name)
            log(f"interface: auto-selected {chosen.name} "
                f"(driver={adapter_driver(chosen.name) or 'unknown'})")
        else:
            if args.command not in ("tui", "selftest", "deps", "preflight"):
                print("no wireless interface found; plug in a WiFi adapter "
                      "or pass --interface")
                return 2

    if args.command == "tui":
        return TUI(state).run(force_plain=getattr(args, "plain", False))

    phase_map = {
        "preflight": ["preflight"],
        "scan": ["preflight", "scan"],
        "capture": ["preflight", "scan", "capture", "filter"],
        "plan": ["preflight", "scan", "capture", "filter", "plan"],
        "attack": ["preflight", "scan", "capture", "filter", "plan", "attack"],
        "report": ["preflight", "scan", "capture", "filter", "plan", "attack",
                   "report"],
        "all": ["preflight", "scan", "capture", "filter", "plan", "attack",
                "report"],
    }
    phases = phase_map[args.command]

    if args.dry_run and args.command in ("plan", "attack", "all"):
        phases = [p for p in phases if p not in ("capture", "attack", "report")]
        phases.append("plan")

    # "plan" can review an existing capture without touching the radio
    if args.command == "plan" and (workdir / "bell.22000").exists():
        phases = ["preflight", "plan"]

    workflow.run(phases)

    if args.command == "plan" or (args.dry_run and "plan" in phases):
        speed = detect_speed(cfg, workdir, log)
        plan = state.plan or build_plan(
            state.entries, cfg,
            Path(cfg.get("_bell_hashes") or workdir / "bell.22000"),
            speed, workdir / "masks",
        )
        if args.json:
            print(json.dumps([s.to_dict() for s in plan], indent=2, default=str))
        else:
            print_plan(plan, speed)
        return 0

    if args.json:
        print(json.dumps(state.payload or state.preflight, indent=2, default=str))
    else:
        if state.error:
            print(f"error: {state.error}")
        elif state.payload:
            summary = state.payload
            print(f"hashes {summary.get('hashes', 0)}  "
                  f"cracked {summary.get('cracked_count', 0)}")
            for item in summary.get("results", []):
                if item.get("cracked"):
                    print(f"  [OK] {item['essid']} {item['bssid']} {item['key']}")
        else:
            print("done")
    return 1 if state.error else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.stderr.write("\ninterrupted\n")
        sys.exit(130)
