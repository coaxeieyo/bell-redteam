@dataclass
class WirelessIface:
    name: str
    mac: str = ""
    kind: str = "managed"  # managed | monitor | other
    phy: str = ""
    channel: Optional[int] = None
    txpower: Optional[float] = None
    virtual: bool = False
    channels: List[int] = field(default_factory=list)

    @property
    def label(self) -> str:
        tag = "virtual" if self.virtual else "physical"
        return f"{self.name} ({tag}, {self.kind})"

