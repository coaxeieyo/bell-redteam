                    "(authorized lab use only).",
    )
    parser.add_argument(
        "command",
        nargs="?",
        default="tui",
        choices=[
            "tui", "preflight", "scan", "capture", "plan", "attack", "report",
            "all", "selftest", "deps",
        ],
    )
    parser.add_argument("--workdir", default=str(WORKDIR_DEFAULT))
    parser.add_argument("--interface", default=None)
    parser.add_argument("--essid-regex", default=None)
    parser.add_argument("--mask-len", type=int, default=None)
    parser.add_argument("--mask-charset", default=None)
    parser.add_argument("--mask-order", choices=["effective", "requested"],
                        default=None)
    parser.add_argument("--backend", choices=["wifite", "hcxdumptool"],
                        default=None)
