        d = asdict(self)
        d["label"] = self.label
        return d


def _parse_iw_phy_channels(phy: str) -> List[int]:
    """Supported channels from `iw phy <phy> info`."""
    if not phy:
        return []
    proc = run(["iw", "phy", phy, "info"], timeout=15)
    if proc.returncode != 0:
        return []
    channels: List[int] = []
    for line in proc.stdout.splitlines():
        # iw prints "  * 2412.0 MHz [1] (22.0 dBm)"
        if "MHz" not in line:
            continue
        m = re.search(r"\[\s*(\d+)\s*\]", line)
        if m:
            channels.append(int(m.group(1)))
    return sorted(set(channels))


def list_interfaces(include_channels: bool = True) -> List[WirelessIface]:
    """Enumerate wireless interfaces from `iw dev`.

    airmon-ng style virtual monitors (wlanmon0, mon1) are flagged virtual so
    the UI can warn: hcxdumptool's own guidance is to avoid virtual
    interfaces and to let it set monitor mode itself.
    """
    proc = run(["iw", "dev"], timeout=15)
    if proc.returncode != 0:
        return []

    ifaces: List[WirelessIface] = []
    current: Optional[WirelessIface] = None
    phy = ""

    for raw in proc.stdout.splitlines():
        line = raw.strip()
        if line.startswith("phy#"):
            # "phy#0" in `iw dev` output, "phy0" for `iw phy <name> info`
            phy = line.split()[0].replace("#", "")
            current = None
            continue
        if line.startswith("Interface "):
            name = line.split(None, 1)[1].strip()
            current = WirelessIface(name=name, phy=phy)
            current.virtual = bool(re.match(r"^(wlan)?mon\d+$", name))
            ifaces.append(current)
            continue
        if line.startswith("Unnamed/non-netdev interface"):
            current = None
            continue
        if current is None:
            continue
        if line.startswith("addr "):
            current.mac = line.split(None, 1)[1].strip()
        elif line.startswith("type "):
            current.kind = line.split(None, 1)[1].strip()
        elif line.startswith("channel "):
            m = re.search(r"channel\s+(\d+)", line)
            if m:
                current.channel = int(m.group(1))
        elif line.startswith("txpower "):
            m = re.search(r"txpower\s+([\d.]+)", line)
            if m:
                current.txpower = float(m.group(1))

    if include_channels:
        cache: Dict[str, List[int]] = {}
        for iface in ifaces:
            if iface.phy not in cache:
                cache[iface.phy] = _parse_iw_phy_channels(iface.phy)
            iface.channels = list(cache[iface.phy])
    return ifaces


_MONITOR_CAPABLE: Dict[str, bool] = {}


def monitor_capable(iface: WirelessIface) -> bool:
    """True when the driver can be switched to monitor mode."""
    if iface.name in _MONITOR_CAPABLE:
        return _MONITOR_CAPABLE[iface.name]
    if not iface.phy:
        _MONITOR_CAPABLE[iface.name] = False
        return False
    proc = run(["iw", "phy", iface.phy, "info"], timeout=15)
    if proc.returncode != 0:
        _MONITOR_CAPABLE[iface.name] = False
        return False
    result = "monitor" in proc.stdout.lower()
    _MONITOR_CAPABLE[iface.name] = result
    return result


def adapter_driver(iface: str) -> str:
    """Return the kernel driver name for a network interface, or ''."""
    try:
        link = Path(f"/sys/class/net/{iface}/device/driver")
        if link.exists() or link.is_symlink():
            return link.resolve().name
    except OSError:
        pass
    return ""


USB_WIFI_DRIVERS = {
    "rt2800usb", "rt2870sta", "rt2500usb", "rt73usb",   # Ralink
    "ath9k_htc", "ath9k",                                 # Atheros / TP-Link v1
    "rtl8188eu", "r8188eu", "rtl8xxxu",                  # Realtek / TP-Link v2
    "rtl8812au", "rtl8821au", "rtw88_8821au",           # TP-Link Archer
    "rtl8187", "rtl8192cu", "rtl8192eu",                 # older Realtek
}

RALINK_DRIVERS = {"rt2800usb", "rt2870sta", "rt2500usb", "rt73usb"}


def interface_rank(iface: WirelessIface) -> tuple:
    """Sort key: Ralink USB adapters first, then physical, then monitor-capable."""
    driver = adapter_driver(iface.name).lower()
    return (
        0 if driver in RALINK_DRIVERS else 1,
        1 if iface.virtual else 0,
        0 if monitor_capable(iface) else 1,
        iface.name,
    )


def preferred_interface(ifaces: Sequence[WirelessIface]) -> Optional[WirelessIface]:
    """Return the adapter the UI should select by default."""
    return min(ifaces, key=interface_rank) if ifaces else None


