# Resolve the real user's home when running under sudo so output lands in
# their filesystem (not just root's). Fall back to the current user otherwise.
def _real_home() -> Path:
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user and sudo_user != "root":
        try:
            import pwd
            return Path(pwd.getpwnam(sudo_user).pw_dir)
        except KeyError:
            pass
    return Path.home()


def chown_to_real_user(path: Path) -> None:
    """Best-effort: hand ownership of `path` back to the invoking (sudo) user."""
    sudo_user = os.environ.get("SUDO_USER")
    if not sudo_user or sudo_user == "root":
        return
    if os.geteuid() != 0:
        return
    try:
        import pwd
        pw = pwd.getpwnam(sudo_user)
        uid, gid = pw.pw_uid, pw.pw_gid
    except KeyError:
        return
    try:
        if path.is_dir():
            for root, dirs, files in os.walk(path):
                for name in dirs + files:
                    try:
                        os.chown(os.path.join(root, name), uid, gid)
                    except OSError:
                        pass
            try:
                os.chown(str(path), uid, gid)
            except OSError:
                pass
        else:
            try:
                os.chown(str(path), uid, gid)
            except OSError:
                pass
    except OSError:
        pass


