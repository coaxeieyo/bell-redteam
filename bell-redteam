# hashcat runner
# --------------------------------------------------------------------------

# "Speed.#1.........:      948 H/s (66.78ms) @ Accel:64 ..." (benchmark)
# and "Speed.#1: 4 H/s" (--speed-only) are both accepted.
SPEED_RE = re.compile(r"Speed\.#\d+[.\s:]*([\d.]+)\s*([kMGT]?)H/s", re.IGNORECASE)


def detect_speed(cfg: Config, workdir: Path, log: Log) -> Optional[float]:
    """Measure hashcat mode 22000 throughput, capped to the core budget.

    Every device is summed, so a machine with two GPUs reports the
    combined rate, and the benchmark runs on the same devices the attack
    will use.  The cached value is only reused when the configuration
    that produced it has not changed.
    """
    override = cfg.get("hashcat_speed")
    if override:
        return float(override)

    cores = max(1, int(cfg.get("hashcat_cores") or 2))
    devices = str(cfg.get("hashcat_device_ids") or "")
    cache = workdir / "speed.json"
    cached = read_json(cache, None)
    if (
        isinstance(cached, dict)
        and cached.get("speed")
        and cached.get("cores") == cores
        and str(cached.get("devices") or "") == devices
    ):
        return float(cached["speed"])

    if not have("hashcat"):
        return None

    cmd = ["taskset", "-c", cores_spec(cores), "hashcat", "-b", "-m", "22000",
           "--quiet"]
    if devices:
        cmd += ["-d", devices]
    log("speed: benchmarking hashcat mode 22000 (capped to %d core(s))" % cores)
    proc = run(cmd, timeout=180)
    def _parse_speed(proc_obj: subprocess.CompletedProcess) -> float:
        parsed = 0.0
        for line in (proc_obj.stdout + proc_obj.stderr).splitlines():
            for match in SPEED_RE.finditer(line):
                value = float(match.group(1))
                mult = {"": 1.0, "k": 1e3, "m": 1e6, "g": 1e9, "t": 1e12}
                parsed += value * mult.get(match.group(2).lower(), 1.0)
        return parsed

    total = _parse_speed(proc)
    # Broken OpenCL backends can report a tiny or zero rate; retry once with
    # --force (CPU backend) before giving up.
    if total < 100:
        proc2 = run(cmd + ["--force"], timeout=180)
        total2 = _parse_speed(proc2)
        if total2 > total:
            total = total2
            proc = proc2
    if total <= 0:
        log("speed: benchmark produced no rate, assuming 3000 H/s", "warn")
        return 3000.0
    if total < 100:
        log("speed: measured throughput is very low "
            f"({total:,.0f} H/s) - hashcat is likely using a broken "
            "OpenCL/CPU backend. Install GPU drivers or set "
            "hashcat_speed in config to override.", "warn")
    log(f"speed: {total:,.0f} H/s over all devices")
    write_json(cache, {"speed": total, "cores": cores, "devices": devices,
                       "at": time.strftime("%Y-%m-%dT%H:%M:%S")})
    return total


def cores_spec(cores: int) -> str:
    cores = max(1, int(cores))
    return f"0-{cores - 1}" if cores > 1 else "0"


def hashcat_needs_force(log: Log) -> bool:
    proc = run(["hashcat", "-I"], timeout=60)
    blob = (proc.stdout + proc.stderr).lower()
    return "no devices found" in blob or "unstable opencl driver" in blob


@dataclass
class StepResult:
    name: str
    status: str  # done | exhausted | skipped | error
    detail: str = ""
    cracked: List[Cracked] = field(default_factory=list)
    elapsed: float = 0.0
    log_path: Optional[Path] = None


@dataclass
class Cracked:
    """A recovered passphrase together with the AP it belongs to."""

    essid: str
    bssid: str = ""
    sta: str = ""
    password: str = ""


def show_cracked(hashes: Path, potfile: Path) -> List[Cracked]:
    """Return the keys recovered for `hashes` from the potfile.

    For mode 22000 hashcat's --show output is the canonical colon form
    "<digest>:<ap>:<sta>:<essid>:<password>", not the raw hc22000 line.
    """
    out: List[Cracked] = []
    if not hashes.exists():
        return out
    proc = run(
        [
            "hashcat",
            "-m",
            "22000",
            "--show",
            "--potfile-path",
            str(potfile),
            str(hashes),
        ],
        timeout=120,
    )
    for line in proc.stdout.splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        head, _, password = line.rpartition(":")
        parts = head.split(":", 3)
        if len(parts) < 2:
            continue
        out.append(
            Cracked(
                essid=parts[3] if len(parts) > 3 else "",
                bssid=parts[1].replace(":", "").lower(),
                sta=parts[2].replace(":", "").lower(),
                password=password.strip(),
            )
        )
    return out


def save_terminal_state() -> None:
    """Save curses + termios state before handing the tty to a subprocess."""
    if curses is None:
        return
    try:
        curses.def_prog_mode()
    except Exception:
        pass
    try:
        curses.savetty()
    except Exception:
        pass
    try:
        curses.flushinp()
    except Exception:
        pass


def restore_terminal_state(stdscr=None) -> None:
    """Restore curses + termios state after a subprocess returns."""
    if curses is None:
        return
    try:
        curses.reset_prog_mode()
    except Exception:
        pass
    try:
        curses.resetty()
    except Exception:
        pass
    try:
        curses.nocbreak()
        curses.noraw()
        curses.echo()
        curses.nl()
    except Exception:
        pass
    try:
        curses.flushinp()
    except Exception:
        pass
    try:
        curses.curs_set(1)
    except Exception:
        pass
    if stdscr is not None:
        try:
            stdscr.keypad(True)
            stdscr.timeout(-1)
            stdscr.nodelay(False)
            stdscr.clear()
            stdscr.refresh()
        except Exception:
            pass
    try:
        curses.doupdate()
    except Exception:
        pass


def stop_running_step() -> bool:
    """Terminate the hashcat process of the running step."""
    global RUNNING_PROC
    proc = RUNNING_PROC
    if proc is None or proc.poll() is not None:
        return False
    try:
        proc.terminate()
        proc.wait(timeout=15)
    except (OSError, subprocess.TimeoutExpired):
        try:
            proc.kill()
        except OSError:
            pass
    return True


def run_step(
    step: Step,
    cfg: Config,
    workdir: Path,
    log: Log,
    potfile: Path,
    force: bool,
) -> StepResult:
    """Execute one attack step under the configured resource budget."""
    if step.skip_reason:
        return StepResult(step.name, "skipped", step.skip_reason)

    log_dir = workdir / "logs"
    log_dir.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S")
    safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", step.name)
    log_path = log_dir / f"{stamp}_{safe}.log"

    cores = max(1, int(cfg.get("hashcat_cores") or 2))
    raw_budget = cfg.get("max_hours_per_step")
    if raw_budget:
        budget_seconds = float(raw_budget) * 3600.0
    else:
        budget_seconds = None  # 0/None = unlimited

    cmd = [
        "taskset",
        "-c",
        cores_spec(cores),
        "hashcat",
        "-m",
        "22000",
        "-a",
        "3" if step.kind == "mask" else "0",
    ]
    # A session lets an interrupted step resume instead of starting over,
    # which matters for the multi-year alphanumeric mask.  hashcat takes a
    # session *name* and keeps it under its data directory, so the data
    # directory is redirected into the work directory.
    session_name = f"bell-{safe}"
    session_dir = workdir / "xdg" / "hashcat" / "sessions"
    session_dir.mkdir(parents=True, exist_ok=True)
    restore_file = session_dir / f"{session_name}.restore"
    cmd += [
        "--potfile-path",
        str(potfile),
        "--status",
        "--status-timer",
        "10",
        "--quiet",
        "--session",
        session_name,
    ]
    if restore_file.exists():
        cmd.append("--restore")
        log(f"step '{step.name}': resuming the stored session")
    if force:
        cmd.append("--force")
    device_ids = str(cfg.get("hashcat_device_ids") or "").strip()
    if device_ids:
        # -d selects the OpenCL device ids, e.g. "1,2" for two GPUs
        cmd += ["-d", device_ids]
    cmd.append(str(step.hashes))
    if step.kind == "mask":
        if step.mask_file and step.mask_file.exists():
            # hashcat mask file: comma separated charsets, mask last
            cmd.append(str(step.mask_file))
        else:
            for i, cs in enumerate(step.charsets):
                cmd += [f"-{i + 1}", cs]
            cmd.append(step.mask)
    elif step.wordlist:
        cmd.append(str(step.wordlist))

    log(f"step '{step.name}': {' '.join(shlex.quote(c) for c in cmd)}")
    started = time.time()
    status = "exhausted"
    detail = ""
    with log_path.open("w", encoding="utf-8") as fh:
        fh.write("# " + " ".join(cmd) + "\n\n")
        fh.flush()
        try:
            global RUNNING_PROC
            proc = subprocess.Popen(
                cmd,
                stdin=subprocess.DEVNULL,
                stdout=fh,
                stderr=subprocess.STDOUT,
                cwd=str(workdir),
                text=True,
                env={**os.environ, "XDG_DATA_HOME": str(workdir / "xdg")},
                start_new_session=True,
            )
            RUNNING_PROC = proc
            try:
                proc.wait(timeout=budget_seconds)
            except subprocess.TimeoutExpired:
                proc.terminate()
                try:
                    proc.wait(timeout=20)
                except subprocess.TimeoutExpired:
                    proc.kill()
                status = "interrupted"
                detail = f"stopped at the budget ({human_time(budget_seconds)})"
        except OSError as exc:
            status = "error"
            detail = str(exc)
        finally:
            RUNNING_PROC = None
    elapsed = time.time() - started

    if status == "error":
        log(f"step '{step.name}' failed: {detail}", "error")
    else:
        log(f"step '{step.name}' finished in {human_time(elapsed)} ({status})")

    cracked = show_cracked(step.hashes, potfile) if step.hashes else []
    if cracked:
        status = "done"
        detail = f"{len(cracked)} key(s) recovered"
    return StepResult(step.name, status, detail, cracked, elapsed, log_path)


