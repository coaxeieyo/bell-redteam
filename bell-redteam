    def _screen_config(self, stdscr) -> str:
        row_idx = 0
        while True:
            stdscr.erase()
            row = self._header(stdscr, "Stealth and attack settings")
            self._put(stdscr, row, 2, "  Settings (Enter edits, d restores the "
                                      "default)", curses.color_pair(1) | curses.A_BOLD)
            for i, (key, label, kind) in enumerate(self.SETTINGS):
                value = self.cfg.get(key)
                if kind == "bool":
                    shown = "yes" if value else "no"
                elif kind == "choice":
                    shown = str(value)
                else:
                    shown = str(value)
                selected = i == row_idx
                attr = curses.color_pair(2) | curses.A_BOLD if selected else 0
                self._put(stdscr, row + 2 + i, 2,
                          f" {'>' if selected else ' '} {label:<30} {shown}",
                          attr)
            why = row + 2 + len(self.SETTINGS) + 1
            key, label, _ = self.SETTINGS[row_idx]
            if key in self.RATIONALE:
                self._put(stdscr, why, 2, "  " + self.RATIONALE[key],
                          curses.color_pair(6))
            if self.status:
                self._put(stdscr, why + 1, 2, "  " + self.status,
                          curses.color_pair(3))
            self._footer(stdscr, "[Up/Down] move   [Enter] edit   [d] default   "
                                "[s] save   [n] next   [q] quit")
            stdscr.refresh()
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return "quit"
            if key in (curses.KEY_DOWN, ord("j")):
                row_idx = (row_idx + 1) % len(self.SETTINGS)
            elif key in (curses.KEY_UP, ord("k")):
                row_idx = (row_idx - 1) % len(self.SETTINGS)
            elif key in (ord("d"), ord("D")):
                skey, _, _ = self.SETTINGS[row_idx]
                self.cfg.set(skey, DEFAULTS[skey])
            elif key in (ord("s"), ord("S")):
                self.cfg.save(self.workdir_config())
                self.status = "settings saved"
            elif key in (ord("n"), ord("N")):
                self.cfg.save(self.workdir_config())
                return "targets"
            elif key in (10, 13, curses.KEY_ENTER):
                self._edit(stdscr, self.SETTINGS[row_idx])
                self.status = ""

    def workdir_config(self) -> Path:
        return self.state.workdir / "config.json"

    def _edit(self, stdscr, setting) -> None:
        key, label, kind = setting
        h, w = stdscr.getmaxyx()
        if h < 5 or w < 20:
            return
        if kind == "bool":
            self.cfg.set(key, not bool(self.cfg.get(key)))
            return
        if kind == "choice":
            options = CHOICES.get(key, [])
            if not options:
                return
            current = str(self.cfg.get(key))
            idx = options.index(current) if current in options else 0
            self.cfg.set(key, options[(idx + 1) % len(options)])
            return
        h, w = stdscr.getmaxyx()
        prompt = f"  {label}: "
        self._put(stdscr, h - 3, 2, prompt)
        try:
            curses.echo()
            curses.curs_set(1)
            field = stdscr.getstr(h - 3, 2 + len(prompt), 60)
            curses.curs_set(0)
            curses.noecho()
        except curses.error:
            field = b""
        finally:
            curses.noecho()
        value = field.decode("utf-8", errors="replace").strip() if field else ""
        if not value:
            return
        if kind == "int":
            self.cfg.set(key, safe_int(value, int(self.cfg.get(key) or 0)))
        elif kind == "float":
            self.cfg.set(key, safe_float(value, float(self.cfg.get(key) or 0.0)))
        else:
            self.cfg.set(key, value)

    # -- screen: targets -------------------------------------------------
    def _screen_targets(self, stdscr) -> str:
        workflow = Workflow(self.state)
        if not self.state.targets:
            # the scan runs in the background so the interface stays alive
            self.state.message = "scanning for access points"
            save_terminal_state()
            scan_error: Dict[str, Exception] = {}
            def _run_scan() -> None:
                try:
                    workflow.do_scan()
                except Exception as exc:  # noqa: BLE001 - surface in TUI
                    scan_error["exc"] = exc
            scanner = threading.Thread(target=_run_scan, daemon=True)
            scanner.start()
            while scanner.is_alive():
                stdscr.timeout(200)
                stdscr.erase()
                row = self._header(stdscr, "Select BELL targets")
                self._put(stdscr, row + 1, 2,
                          "  scanning for access points, please wait ...",
                          curses.color_pair(2))
                self._footer(stdscr, "[q] quit")
                stdscr.refresh()
                if stdscr.getch() in (ord("q"), ord("Q")):
                    return "quit"
            scanner.join()
            restore_terminal_state(stdscr)
            if "exc" in scan_error:
                self.state.message = f"scan failed: {scan_error['exc']}"
                self.log(f"scan failed: {scan_error['exc']}", "error")
                return "config"

        for target in self.state.targets:
            target.selected = True
        idx = 0
        try:
            curses.flushinp()
        except Exception:
            pass
        stdscr.timeout(-1)
        stdscr.nodelay(False)
        try:
            curses.noecho()
            curses.cbreak()
        except Exception:
            pass
        while True:
            stdscr.erase()
            row = self._header(stdscr, "Select BELL targets")
            targets = self.state.targets
            preferred = [t for t in targets
                         if is_preferred(t.essid, self.cfg)]
            if not targets:
                self._put(stdscr, row, 2, "No access points were found.",
                          curses.color_pair(4))
            else:
                self._put(stdscr, row, 2,
                          "  *  preferred (BELL7 by default), selected by default",
                          curses.color_pair(6))
                self._put(stdscr, row + 1, 2,
                          "     #  ESSID                    BSSID               "
                          "ch   signal  enc      selected",
                          curses.color_pair(1) | curses.A_BOLD)
                for i, target in enumerate(targets):
                    selected = i == idx
                    attr = curses.color_pair(2) | curses.A_BOLD if selected else 0
                    mark = "[x]" if target.selected else "[ ]"
                    star = "*" if is_preferred(target.essid, self.cfg) else " "
                    self._put(
                        stdscr, row + 3 + i, 2,
                        f" {'>' if selected else ' '} {star} {i:>2}  "
                        f"{target.essid:<23} {target.bssid:<18} "
                        f"{str(target.channel or '-'):<4} {target.signal:<7} "
                        f"{target.encr:<8} {mark}",
                        attr,
                    )
            self._footer(stdscr, "[Up/Down] move   [Space] toggle   [a] all   "
                                "[p] preferred only   [n] none   [s] rescan   "
                                "[Enter] continue   [q] quit")
            stdscr.refresh()
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return "quit"
            if key in (curses.KEY_DOWN, ord("j")):
                idx = min(idx + 1, max(0, len(targets) - 1))
            elif key in (curses.KEY_UP, ord("k")):
                idx = max(0, idx - 1)
            elif key == ord(" "):
                if targets:
                    targets[idx].selected = not targets[idx].selected
            elif key in (ord("a"), ord("A")):
                for target in targets:
                    target.selected = True
            elif key in (ord("p"), ord("P")):
                for target in targets:
                    target.selected = is_preferred(target.essid, self.cfg)
            elif key in (ord("n"), ord("N")):
                for target in targets:
                    target.selected = False
            elif key in (ord("s"), ord("S")):
                self.state.targets = []
                scanner = threading.Thread(target=workflow.do_scan, daemon=True)
                scanner.start()
                while scanner.is_alive():
                    stdscr.timeout(200)
                    stdscr.refresh()
                    stdscr.getch()
                scanner.join()
                idx = 0
            elif key in (10, 13, curses.KEY_ENTER):
                self.cfg.save(self.workdir_config())
                return "run"

    # -- screen: run -----------------------------------------------------
    def _screen_run(self, stdscr) -> str:
        workflow = Workflow(self.state)
        self.workflow = workflow
        phases = ["preflight", "capture", "filter", "plan", "attack", "report"]
        if not self.state.targets:
            phases.insert(1, "scan")
        self.thread = threading.Thread(
            target=workflow.run, args=(phases,), daemon=True
        )
        save_terminal_state()
        self.thread.start()
        restored = False

        while True:
            stdscr.erase()
            row = self._header(stdscr, "Attack phases")
            state = self.state
            self._put(
                stdscr, row, 2,
                f"  Phase {state.phase_index}/{state.phase_total}: {state.phase}"
                f"   {state.message}",
                curses.color_pair(2) | curses.A_BOLD,
            )
            if state.error:
                self._put(stdscr, row + 1, 2, "  ERROR: " + state.error,
                          curses.color_pair(4))

            step_row = row + 3
            self._put(stdscr, step_row, 2, "  Step checklist", curses.color_pair(1)
                      | curses.A_BOLD)
            for i, step in enumerate(state.plan):
                status = state.step_state.get(step.name, "pending")
                attr = 0
                mark = "."
                if status == "running":
                    mark, attr = ">", curses.color_pair(2) | curses.A_BOLD
                elif status == "done":
                    mark, attr = "+", curses.color_pair(3)
                elif status == "skipped":
                    mark, attr = "-", curses.color_pair(6)
                elif status == "error":
                    mark, attr = "x", curses.color_pair(4)
                eta = human_time(step.est_seconds) if step.est_seconds else "-"
                self._put(
                    stdscr, step_row + 2 + i, 2,
                    f"  {mark} {step.name:<28} {human_count(step.keyspace):>10} "
                    f"keyspace  eta {eta:<8} {status}",
                    attr,
                )
                detail = state.step_detail.get(step.name, "")
                if detail:
                    self._put(stdscr, step_row + 3 + i, 6, detail[:100],
                              curses.color_pair(6))

            log_row = step_row + 3 + max(1, len(state.plan)) + 2
            self._put(stdscr, log_row, 2, "  Output", curses.color_pair(1) | curses.A_BOLD)
            for i, line in enumerate(state.current_log[-8:]):
                self._put(stdscr, log_row + 2 + i, 2, line[:140])

            if state.done:
                if not restored:
                    restore_terminal_state(stdscr)
                    restored = True
                self._footer(stdscr, "[Enter] results   [q] quit")
            else:
                self._footer(stdscr, "[q] stop   (phases run automatically)")
            stdscr.refresh()

            if state.done:
                stdscr.timeout(-1)
            else:
                stdscr.timeout(500)
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                state.stop_requested = True
                if stop_running_step():
                    state.message = "the running step was stopped"
                if self.thread:
                    self.thread.join(timeout=20)
                stdscr.timeout(-1)
                return "results"
            if state.done and key in (10, 13, curses.KEY_ENTER):
                if self.thread:
                    self.thread.join(timeout=5)
                stdscr.timeout(-1)
                return "results"

    # -- screen: results -------------------------------------------------
    def _screen_results(self, stdscr) -> str:
        payload = self.state.payload
        while True:
            stdscr.erase()
            row = self._header(stdscr, "Results")
            if not payload:
                self._put(stdscr, row, 2, "  No report generated yet.",
                          curses.color_pair(6))
            else:
                self._put(stdscr, row, 2,
                          f"  hashes {payload.get('hashes', 0)}   "
                          f"cracked {payload.get('cracked_count', 0)}   "
                          f"essids {', '.join(payload.get('essids', [])) or '-'}",
                          curses.color_pair(2) | curses.A_BOLD)
                self._put(stdscr, row + 2, 2, "  ESSID                    BSSID"
                          "               KEY", curses.color_pair(1) | curses.A_BOLD)
                for i, item in enumerate(payload.get("results", [])):
                    attr = curses.color_pair(3) if item.get("cracked") else 0
                    self._put(stdscr, row + 4 + i, 2,
                              f"  {item.get('essid', ''):<23} "
                              f"{item.get('bssid', ''):<18} "
                              f"{item.get('key', '')}", attr)
                if self.state.error:
                    self._put(stdscr, row + 6 + len(payload.get("results", [])),
                              2, "  error: " + self.state.error,
                              curses.color_pair(4))
            self._footer(stdscr, "[w] write report   [q] quit")
            stdscr.refresh()
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return "quit"
            if key in (ord("w"), ord("W")):
                Workflow(self.state).do_report()
                payload = self.state.payload

    # -- plain fallback --------------------------------------------------
    def _plain(self) -> int:
        print(f"{APP} {VERSION} - plain mode")
        workflow = Workflow(self.state)
        info = workflow.preflight()
        missing = info.get("missing", [])
        if missing:
            print(f"missing tools: {', '.join(missing)}")
        ifaces = info.get("interfaces", [])
        if not ifaces:
            print("no wireless interfaces found")
            return 0
        print("\navailable adapters:")
        preferred = preferred_interface(list_interfaces())
        for i, iface in enumerate(ifaces):
            drv = adapter_driver(iface['name']) or '-'
            mark = " (preferred)" if preferred and iface['name'] == preferred.name else ""
            print(f"  [{i}] {iface['name']:<14} {iface['kind']:<10} "
                  f"{'virtual' if iface['virtual'] else 'physical':<9} "
                  f"{iface['mac']:<18} {drv}{mark}")
        try:
            choice = input("\nadapter number (blank to quit): ").strip()
        except (EOFError, KeyboardInterrupt):
            return 0
        if not choice:
            return 0
        if choice.isdigit():
            idx = int(choice)
            if 0 <= idx < len(ifaces):
                choice = ifaces[idx]["name"]
            else:
                print(f"invalid selection {idx}")
                return 0
        self.cfg.set("interface", choice)
        self.cfg.save(self.workdir_config())
        print(f"using {choice}")

        try:
            seconds = max(60, int(self.cfg.get("scan_seconds") or DEFAULTS["scan_seconds"]))
            input(f"\npress Enter to scan for access points ({seconds}s)...")
        except (EOFError, KeyboardInterrupt):
            return 0
        workflow.do_scan()
        targets = self.state.targets
        if not targets:
            print("no matching access points found")
            return 0
        print(f"\n{len(targets)} access point(s) in scope:")
        for i, t in enumerate(targets):
            mark = "[x]" if t.selected else "[ ]"
            pref = "*" if is_preferred(t.essid, self.cfg) else " "
            print(f"  {pref} {i:>2}  {t.essid:<24} {t.bssid:<18} "
                  f"ch{str(t.channel or '-'):<3} {t.signal:>4}  {mark}")
        print("\ncommands: 'a'=all  'p'=preferred only  'n'=none  "
              "'<num>'=toggle  'Enter'=continue  'q'=quit")
        while True:
            try:
                cmd = input("> ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                return 0
            if cmd == "q":
                return 0
            if cmd == "a":
                for t in targets:
                    t.selected = True
            elif cmd == "p":
                for t in targets:
                    t.selected = is_preferred(t.essid, self.cfg)
            elif cmd == "n":
                for t in targets:
                    t.selected = False
            elif cmd == "":
                break
            elif cmd.isdigit() and 0 <= int(cmd) < len(targets):
                targets[int(cmd)].selected = not targets[int(cmd)].selected
            else:
                print("unknown command")
                continue
            for i, t in enumerate(targets):
                mark = "[x]" if t.selected else "[ ]"
                pref = "*" if is_preferred(t.essid, self.cfg) else " "
                print(f"  {pref} {i:>2}  {t.essid:<24} {t.bssid:<18} "
                      f"ch{str(t.channel or '-'):<3} {t.signal:>4}  {mark}")

        print("\nrunning attack phases...")
        phases = ["capture", "filter", "plan", "attack", "report"]
        workflow.run(phases)
        if self.state.error:
            print(f"error: {self.state.error}")
        if self.state.payload:
            p = self.state.payload
            print(f"\nhashes {p.get('hashes', 0)}  "
                  f"cracked {p.get('cracked_count', 0)}")
            for item in p.get("results", []):
                if item.get("cracked"):
                    print(f"  [OK] {item['essid']} {item['bssid']} {item['key']}")
        return 0 if not self.state.error else 1


