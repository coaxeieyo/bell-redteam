def _synthetic_hash(essid: str, password: str) -> str:
    """Build a valid hc22000 PMKID line for a known password.

    The PMKID is 128 bit and is not a plain PBKDF2 truncation:

        PMK   = PBKDF2-HMAC-SHA1(password, ESSID, 4096, 32)
        PMKID = Truncate128(HMAC-SHA1(PMK, "PMK Name" || AA || SPA))

    where AA is the access point MAC and SPA the station MAC. Verified
    against hashcat's own published example hash for mode 22000.
    """
    import hashlib
    import hmac

    ap = "fc690c158264"
    sta = "f4747f87f9f4"
    pmk = hashlib.pbkdf2_hmac(
        "sha1", password.encode("utf-8"), essid.encode("utf-8"), 4096, 32
    )
    context = b"PMK Name" + bytes.fromhex(ap) + bytes.fromhex(sta)
    pmkid = hmac.new(pmk, context, hashlib.sha1).digest()[:16]
    return (
        f"WPA*01*{pmkid.hex()}*{ap}*{sta}*"
        f"{essid.encode('utf-8').hex()}***"
    )


def selftest(run_hashcat_check: bool = True) -> int:
    """Offline validation of the parser, the planner and the mask syntax."""
    failures: List[str] = []

    def check(name: str, condition: bool, detail: str = "") -> None:
        if condition:
            print(f"  ok   {name}")
        else:
            print(f"  FAIL {name} {detail}")
            failures.append(name)

    print("bell-redteam selftest")

    # 1. hc22000 parsing
    essid = "BELL726"
    password = "BELLaaaaaaa"
    line = _synthetic_hash(essid, password)
    entry = parse_22000(line)
    check("hc22000 line parses", entry is not None)
    if entry:
        check("ESSID recovered from field 5", entry.essid == essid,
              f"got {entry.essid!r}")
        check("AP MAC recovered", entry.bssid == "fc690c158264",
              f"got {entry.bssid!r}")
        check("PMKID recovered", entry.pmkid == line.split("*")[2])

    # 1b. the hashcat reference hash must parse the same way
    reference = ("WPA*01*4d4fe7aac3a2cecab195321ceb99a7d0*fc690c158264*"
                 "f4747f87f9f4*686173686361742d6573736964***")
    ref = parse_22000(reference)
    check("hashcat's published example hash parses",
          ref is not None and ref.essid == "hashcat-essid",
          f"got {ref.essid if ref else None!r}")

    # 1c. the airodump-ng CSV column map, verified against the upstream
    #     writer in src/airodump-ng/dump_write.c
    csv_path = Path("/tmp/kilo/bell-selftest-scan.csv")
    csv_path.write_text(
        "BSSID, First time seen, Last time seen, channel, Speed, Privacy, "
        "Cipher, Authentication, Power, # beacons, # IV, LAN IP, ID-length, "
        "ESSID, Key\r\n"
        "Station MAC, First time seen, Last time seen, Power, # packets, "
        "BSSID, Probed ESSIDs\r\n"
        "AA:BB:CC:DD:EE:01, 2026-10-20 15:01:02, 2026-10-20 15:04:02,  6, "
        " 54, WPA2, CCMP, PSK, -42,   12,   340, 0.0.0.0,   7, BELL726, \r\n"
        "AA:BB:CC:DD:EE:02, 2026-10-20 15:01:02, 2026-10-20 15:04:02, 11, "
        " 11, WPA2, TKIP, PSK, -70,    3,     0, 0.0.0.0,   8, BELL706, \r\n",
        encoding="utf-8",
    )
    parsed = parse_airodump_csv(csv_path)
    check("the airodump CSV yields one access point per row", len(parsed) == 2,
          str(len(parsed)))
    if len(parsed) == 2:
        check("the ESSID comes from column 13",
              parsed[0].essid == "BELL726", repr(parsed[0].essid))
        check("the channel comes from column 3", parsed[0].channel == 6,
              str(parsed[0].channel))
        check("the signal comes from column 8", parsed[0].signal == -42,
              str(parsed[0].signal))
        check("the id length comes from column 12", parsed[0].length == 7,
              str(parsed[0].length))
        check("the encryption is read from the privacy and cipher columns",
              "WPA2" in parsed[0].encr and "CCMP" in parsed[0].encr,
              parsed[0].encr)
        check("the second access point is parsed as well",
              parsed[1].essid == "BELL706" and parsed[1].channel == 11,
              f"{parsed[1].essid} {parsed[1].channel}")

    # 2. charset expansion
    check("charset Aa0-9 expands to 62 chars",          len(expand_charset("Aa0-9")) == 62,
          f"got {len(expand_charset('Aa0-9'))}")
    check("charset Aa0-9 content is correct",
          expand_charset("Aa0-9") == ("ABCDEFGHIJKLMNOPQRSTUVWXYZ"
                                      "abcdefghijklmnopqrstuvwxyz0123456789"))
    check("charset 0-9 expands to 10 digits",
          expand_charset("0-9") == "0123456789")
    check("charset Aa09 expands to the same 62 characters",
          expand_charset("Aa09") == expand_charset("Aa0-9"))

    # 2b. the scope: everything in range, with the BELL7 networks preferred
    scope_cfg = Config()
    check("the default scope is everything in range",
          scope_regex(scope_cfg) == ".*", scope_regex(scope_cfg))
    scope_cfg.set("scope_preset", "bell7")
    check("the bell7 preset selects the BELL7 networks",
          scope_regex(scope_cfg) == "^BELL7..$", scope_regex(scope_cfg))
    check("the bell7 preset accepts BELL777",
          re.search(scope_regex(scope_cfg), "BELL777", re.IGNORECASE) is not None)
    check("the bell7 preset rejects a bare BELL7",
          re.search(scope_regex(scope_cfg), "BELL7", re.IGNORECASE) is None)
    check("the bell7 preset rejects an unrelated network",
          re.search(scope_regex(scope_cfg), "SomeOtherNet", re.IGNORECASE) is None)
    scope_cfg.set("scope_preset", "bell")
    check("the bell preset accepts any BELL network",
          re.search(scope_regex(scope_cfg), "BELL777", re.IGNORECASE) is not None)
    check("the bell preset rejects an unrelated network",
          re.search(scope_regex(scope_cfg), "SomeOtherNet", re.IGNORECASE) is None)
    check("the preferred set is the BELL7 networks",
          is_preferred("BELL777", scope_cfg) and is_preferred("bell706", scope_cfg))
    check("an unrelated network is not preferred",
          not is_preferred("SomeOtherNet", scope_cfg))
    check("the scope needs no typed configuration",
          scope_cfg.get("scope_preset") in CHOICES["scope_preset"])

    # 3. mask chain, built from real Bell SSIDs
    bell_essids = ["BELL726", "BELL706", "bell123", "BELL998"]
    entries = [
        HashEntry(raw=line, mtype="01", essid=essid_name,
                  bssid="fc690c158264", sta="f4747f87f9f4", pmkid="")
        for essid_name in bell_essids
    ]
    cfg = Config()
    cfg.set("ssid_prefix", "BELL")
    cfg.set("mask_len", 8)
    cfg.set("mask_order", "effective")
    plan = build_plan(entries, cfg, Path("/tmp/bell.22000"), 3000.0)
    check("plan is not empty", len(plan) > 0)
    masks = [s.mask for s in plan]
    check("8 character alphanumeric mask is in the chain",
          "?1" * 8 in masks, str(masks))
    check("the documented Bell hex keyspace is in the chain",
          any(s.mask == "?1" * 8 and s.charsets == ["0123456789ABCDEF"]
              for s in plan),
          str([(s.mask, s.charsets) for s in plan]))
    check("the 7 character and prefixed steps are gone by default",
          not any(s.name.startswith("mask:position") for s in plan)
          and not any("prefixed" in s.name for s in plan),
          str([s.name for s in plan]))
    check("effective order is ascending by keyspace",
          all(
              plan[i].keyspace <= plan[i + 1].keyspace
              for i in range(len(plan) - 1)
          ),
          str([s.keyspace for s in plan]))
    check("every mask step has at least one charset",
          all(s.charsets for s in plan if s.kind == "mask" and not s.mask_file))
    check("step names are unique", len({s.name for s in plan}) == len(plan),
          str([s.name for s in plan]))

    def candidate_length(mask: str) -> int:
        """Each '?N' placeholder stands for one character."""
        return len(mask) - mask.count("?")

    check("every mask yields a passphrase of the configured length",
          all(candidate_length(s.mask) in (8, len("BELL") + 8)
              for s in plan if s.kind == "mask" and s.mask),
          str([(s.mask, candidate_length(s.mask)) for s in plan]))
    check("no mask candidate is shorter than the WPA minimum",
          all(candidate_length(s.mask) >= PSK_MIN_LEN
              for s in plan if s.kind == "mask" and s.mask))

    # the evidence masks are opt-in and still produce a lowercase literal
    cfg_evidence = Config()
    cfg_evidence.set("ssid_prefix", "BELL")
    cfg_evidence.set("mask_len", 8)
    cfg_evidence.set("include_evidence_masks", True)
    plan_e = build_plan(entries, cfg_evidence, Path("/tmp/bell.22000"), 3000.0)
    check("the lowercase SSID produced its own literal",
          any(s.mask.startswith("bell") for s in plan_e),
          str([s.mask for s in plan_e]))
    check("the position-hybrid variant is in the chain",
          any("position-hybrid" in s.name for s in plan_e),
          str([s.name for s in plan_e]))

    # 4. derived candidates
    long_entry = HashEntry(raw=line, mtype="01", essid="BELL7261",
                            bssid="fc690c158264", sta="f4747f87f9f4", pmkid="")
    derived = derived_candidates(entries + [long_entry], "BELL")
    check("derived candidates include the ESSID", "BELL7261" in derived)
    check("derived candidates include the lowercase variant", "bell7261" in derived,
          str(derived))
    check("derived candidates drop values under the WPA minimum",
          all(len(c) >= PSK_MIN_LEN for c in derived))
    check("a 7 character ESSID is not offered as a passphrase",
          "BELL726" not in derived, str(derived))

    # 5. the documented Bell keyspace
    check("the Bell keyspace is upper case hexadecimal",
          expand_charset("0-9A-F") == "0123456789ABCDEF")
    check("the Bell keyspace has 16 characters",
          len(expand_charset("0-9A-F")) == 16)
    check("16^8 is 4,294,967,296", 16 ** 8 == 4294967296)
    check("the real recovered Bell key is inside the documented keyspace",
          all(c in "0123456789ABCDEF" for c in BELL_REAL_KEY_EXAMPLE),
          BELL_REAL_KEY_EXAMPLE)
    check("the real recovered Bell key is 8 characters",
          len(BELL_REAL_KEY_EXAMPLE) == 8)
    check("the documented keyspace is 50,000 times smaller than 62^8",
          62 ** 8 // 16 ** 8 > 50000, str(62 ** 8 // 16 ** 8))
    check("the reduced Bell keyspace has 13 characters",
          len(REDUCED_BELL_KEYSPACE) == 13,
          str(len(REDUCED_BELL_KEYSPACE)))
    check("the reduced keyspace omits 0, 8 and B",
          "0" not in REDUCED_BELL_KEYSPACE
          and "8" not in REDUCED_BELL_KEYSPACE
          and "B" not in REDUCED_BELL_KEYSPACE)
    check("13^8 is 815,730,721", 13 ** 8 == 815730721, str(13 ** 8))
    check("the reduced keyspace is smaller than the full Bell keyspace",
          13 ** 8 < 16 ** 8)
    check("the real recovered key A2F7F579 is inside the reduced keyspace",
          all(c in REDUCED_BELL_KEYSPACE for c in "A2F7F579"), "A2F7F579")

    # 6. anti-candidate rules
    for anti in ("aaaaaaaa", "ssssssss", "99999999", "aaaaAAAA", "9999aaaa",
                 "11111111", "abcdefgh", "qwertyui", "abababab"):
        check(f"anti-candidate '{anti}' is rejected",
              bool(anti_candidate_reasons(anti)), anti)
    for good in ("A34rS45t", "A2F7F579", "b3ll726X", "Zk9mQ2wP"):
        check(f"plausible key '{good}' is kept",
              not anti_candidate_reasons(good), good)

    # 7. the policy mask file removes the anti-candidates by construction
    policy_path = Path("/tmp/kilo/bell-selftest-policy.hcmask")
    masks, keyspace = build_policy_mask_file(policy_path, 8)
    check("the policy file has one mask per class assignment", masks == 5796,
          str(masks))
    check("the policy keyspace is 26 percent smaller than 62^8",
          0.70 < keyspace / 62 ** 8 < 0.75, f"{keyspace / 62 ** 8:.4f}")
    policy_lines = policy_path.read_text().splitlines()
    check("every policy line carries its own charsets",
          all(line.count(",") == 3 for line in policy_lines[:50]),
          policy_lines[0])
    check("the policy file has no duplicate masks",
          len({line.split(",")[-1] for line in policy_lines}) == masks)

    # 8. the command line overrides must land on the right config keys
    args = build_arg_parser().parse_args(
        ["--cores", "8", "--max-hours", "6", "--speed", "450000",
         "--backend", "hcxdumptool", "--devices", "1,2"]
    )
    cli_cfg = Config()
    apply_overrides(cli_cfg, args)
    check("--cores sets hashcat_cores", cli_cfg.get("hashcat_cores") == 8,
          str(cli_cfg.get("hashcat_cores")))
    check("--max-hours sets max_hours_per_step",
          cli_cfg.get("max_hours_per_step") == 6.0,
          str(cli_cfg.get("max_hours_per_step")))
    check("--speed sets hashcat_speed", cli_cfg.get("hashcat_speed") == 450000.0,
          str(cli_cfg.get("hashcat_speed")))
    check("--backend sets capture_backend",
          cli_cfg.get("capture_backend") == "hcxdumptool",
          str(cli_cfg.get("capture_backend")))
    check("--devices sets hashcat_device_ids",
          cli_cfg.get("hashcat_device_ids") == "1,2",
          str(cli_cfg.get("hashcat_device_ids")))

    # 5. hashcat end to end with a single candidate
    if run_hashcat_check and have("hashcat"):
        with_tmp = Path("/tmp/kilo/bell-selftest.22000")
        with_tmp.parent.mkdir(parents=True, exist_ok=True)
        with_tmp.write_text(line + "\n", encoding="utf-8")
        pot = with_tmp.with_suffix(".pot")
        proc = run(
            [
                "taskset", "-c", "0",
                "hashcat", "-m", "22000", "-a", "3",
                "-1", "a",
                "--potfile-path", str(pot),
                "--quiet", "--force",
                str(with_tmp),
                "BELL?1?1?1?1?1?1?1",
            ],
            timeout=180,
        )
        found = show_cracked(with_tmp, pot)
        check("hashcat cracked the 1-candidate mask", bool(found),
              f"rc={proc.returncode}")
        if found:
            check("recovered key is correct",
                  any(item.password == password for item in found), str(found))
            check("recovered key maps back to the ESSID",
                  any(item.essid == essid for item in found), str(found))
    else:
        print("  skip hashcat end-to-end check")

    print(f"\n{'FAILED: ' + ', '.join(failures) if failures else 'all checks passed'}")
    return 1 if failures else 0


