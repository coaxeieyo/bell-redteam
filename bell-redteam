def check_deps() -> int:
    """Idempotent dependency check for WiFi adapters and toolchain."""
    wifi_packages = [
        "firmware-linux-nonfree",
        "firmware-misc-nonfree",
        "firmware-realtek",
        "firmware-ath9k-htc",
        "firmware-atheros",
        "firmware-mediatek",
        "iw",
        "ethtool",
    ]
    tools = ["aircrack-ng", "hashcat", "wifite", "hcxdumptool", "hcxpcapngtool",
             "iw", "tcpdump"]
    print("== WiFi driver / firmware packages ==")
    missing_pkgs = []
    for pkg in wifi_packages:
        r = subprocess.run(["dpkg", "-s", pkg], capture_output=True, text=True)
        status = "ok" if r.returncode == 0 else "MISSING"
        if r.returncode != 0:
            missing_pkgs.append(pkg)
        print("  [" + status + "] " + pkg)
    print()
    print("== Toolchain ==")
    missing_tools = []
    for t in tools:
        if which(t):
            print("  [ok] " + t)
        else:
            missing_tools.append(t)
            print("  [MISSING] " + t)
    if missing_pkgs or missing_tools:
        print()
        print("Missing items: " + ", ".join(missing_pkgs + missing_tools))
        print("Install with (when network is available):")
        if missing_pkgs:
            print("  sudo apt-get install -y " + " ".join(missing_pkgs))
        if missing_tools:
            print("  sudo apt-get install -y " + " ".join(missing_tools))
        return 1
    print()
    print("All dependencies present.")
    return 0


