def write_report(
    workdir: Path,
    entries: Sequence[HashEntry],
    results: Sequence[StepResult],
    plan: Sequence[Step],
    log: Log,
) -> Dict[str, Any]:
    cracked: List[Cracked] = []
    for result in results:
        cracked.extend(result.cracked)

    def find_key(entry: HashEntry) -> str:
        for item in cracked:
            if item.essid and item.essid == entry.essid:
                if not item.bssid or not entry.bssid or item.bssid == entry.bssid:
                    return item.password
        for item in cracked:
            if item.bssid and item.bssid == entry.bssid:
                return item.password
        return ""

    rows = []
    for entry in entries:
        key = find_key(entry)
        rows.append(
            {
                "essid": entry.essid,
                "bssid": entry.bssid,
                "sta": entry.sta,
                "type": entry.mtype,
                "cracked": bool(key),
                "key": key,
            }
        )

    payload = {
        "tool": APP,
        "version": VERSION,
        "generated": time.strftime("%Y-%m-%dT%H:%M:%S"),
        "hashes": len(entries),
        "essids": sorted({e.essid for e in entries}),
        "cracked_count": sum(1 for r in rows if r["cracked"]),
        "results": rows,
        "steps": [s.to_dict() for s in plan],
    }
    results_dir = workdir / "results"
    results_dir.mkdir(parents=True, exist_ok=True)
    write_json(results_dir / "summary.json", payload)

    lines = [
        f"{APP} {VERSION} - results",
        f"generated : {payload['generated']}",
        f"hashes    : {payload['hashes']}",
        f"essids    : {', '.join(payload['essids']) or '-'}",
        f"cracked   : {payload['cracked_count']}",
        "",
    ]
    for row in rows:
        if row["cracked"]:
            lines.append(f"  [OK]   {row['essid']}  {row['bssid']}  {row['key']}")
        else:
            lines.append(f"  [--]   {row['essid']}  {row['bssid']}")
    lines.append("")
    for result in results:
        lines.append(
            f"  {result.status:>9}  {result.name}  {human_time(result.elapsed)}"
            + (f"  ({result.detail})" if result.detail else "")
        )
    (results_dir / "summary.txt").write_text("\n".join(lines) + "\n",
                                              encoding="utf-8")
    log(f"report: wrote {results_dir / 'summary.txt'}")

    # Restrict permissions on sensitive report artifacts.
    potfile_path = workdir / "results" / "hashcat.pot"
    for sensitive in (results_dir / "summary.json",
                      results_dir / "summary.txt",
                      potfile_path):
        if sensitive.exists():
            try:
                os.chmod(sensitive, 0o600)
            except OSError:
                pass

    # Persistent loot file: cracked passwords in plaintext, append-only, never
    # cleaned up. Survives across runs so a lab never loses a recovered key.
    loot_path = workdir / "loot.txt"
    try:
        with loot_path.open("a", encoding="utf-8") as fh:
            for row in rows:
                if row["cracked"]:
                    fh.write(
                        f"{time.strftime('%Y-%m-%dT%H:%M:%S')}  "
                        f"ESSID={row['essid']}  BSSID={row['bssid']}  "
                        f"KEY={row['key']}\n"
                    )
            fh.flush()
            os.fsync(fh.fileno())
        try:
            os.chmod(loot_path, 0o600)
        except OSError:
            pass
        chown_to_real_user(loot_path)
        log(f"report: appended cracked keys to {loot_path}")
    except OSError as exc:
        log(f"report: could not write loot file: {exc}", "warn")
    return payload


