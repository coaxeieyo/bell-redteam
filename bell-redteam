@dataclass
class RunState:
    config: Config
    workdir: Path
    log: Log
    phase: str = "idle"
    phase_index: int = 0
    phase_total: int = 0
    message: str = ""
    targets: List[Target] = field(default_factory=list)
    entries: List[HashEntry] = field(default_factory=list)
    plan: List[Step] = field(default_factory=list)
    results: List[StepResult] = field(default_factory=list)
    step_state: Dict[str, str] = field(default_factory=dict)
    step_detail: Dict[str, str] = field(default_factory=dict)
    done: bool = False
    error: str = ""
    stop_requested: bool = False
    payload: Dict[str, Any] = field(default_factory=dict)
    current_log: List[str] = field(default_factory=list)
    preflight: Dict[str, Any] = field(default_factory=dict)


class Workflow:
    """Sequential phase runner shared by the TUI and the CLI."""

    def __init__(self, state: RunState) -> None:
        self.state = state
        self.cfg = state.config
        self.workdir = state.workdir
        self.log = state.log
        self.potfile = self.workdir / "results" / "hashcat.pot"
        self.potfile.parent.mkdir(parents=True, exist_ok=True)
        self._pcapng: Optional[Path] = None
        self._monitor: Optional[MonitorSession] = None

    # -- helpers ---------------------------------------------------------
    def _phase(self, name: str, total: int, index: int, message: str) -> None:
        self.state.phase = name
        self.state.phase_total = total
        self.state.phase_index = index
        self.state.message = message
        self.log(f"phase {index}/{total}: {name} - {message}")

    def _stopped(self) -> bool:
        return self.state.stop_requested

    # -- phases ----------------------------------------------------------
    def preflight(self) -> Dict[str, Any]:
        info: Dict[str, Any] = {
            "root": os.geteuid() == 0,
            "tools": {},
            "missing": [],
            "interfaces": [],
            "hashcat_devices": "",
        }
        for tool in TOOLS_REQUIRED:
            path = which(tool)
            info["tools"][tool] = path or ""
            if not path:
                info["missing"].append(tool)
        for tool in TOOLS_OPTIONAL:
            info["tools"][tool] = which(tool) or ""

        info["interfaces"] = [i.to_dict() for i in list_interfaces()]
        iface = self.cfg.get("interface")
        if iface:
            match = [i for i in list_interfaces() if i.name == iface]
            info["monitor_capable"] = bool(match) and monitor_capable(match[0])
            drv = adapter_driver(str(iface))
            info["adapter_driver"] = drv
            if drv and drv not in USB_WIFI_DRIVERS:
                info.setdefault("warnings", []).append(
                    f"adapter {iface} uses driver '{drv}', which is not in the "
                    f"known USB-WiFi set (Ralink/TP-Link); monitor mode may fail"
                )
        else:
            info["monitor_capable"] = False
            info["adapter_driver"] = ""

        if have("hashcat"):
            proc = run(["hashcat", "-I"], timeout=60)
            lines = (proc.stdout + proc.stderr).splitlines()
            devices = []
            for i, line in enumerate(lines):
                if "Device #" in line and ":" in line:
                    devices.append(line.strip())
                elif line.strip().startswith("Name...."):
                    devices.append(line.strip())
            info["hashcat_devices"] = "; ".join(devices[:6])

        self.state.preflight = info
        if info["missing"]:
            self.log(f"preflight: missing tools {info['missing']}", "warn")
        if not info["root"]:
            self.log("preflight: not running as root - capture needs root", "warn")
        return info

    def _ensure_monitor(self) -> None:
        """Put the adapter into monitor mode once, for the whole run."""
        if self._monitor is not None:
            return
        if str(self.cfg.get("capture_backend") or "wifite") == "hcxdumptool":
            # hcxdumptool sets monitor mode itself
            return
        # Never stop NetworkManager globally: that would kill the user's
        # (possibly wired) internet connection. Per-interface disconnect
        # happens inside prepare_monitor instead.
        try:
            self._monitor = prepare_monitor(
                str(self.cfg.get("interface")),
                str(self.cfg.get("monitor_mode") or "physical"),
                self.log,
            )
        except Exception as exc:  # noqa: BLE001 - surface in TUI
            self.log(f"monitor: failed to set monitor mode: {exc}", "error")
            self._monitor = None
            raise

    def do_scan(self) -> List[Target]:
        iface = self.cfg.get("interface")
        if not iface:
            raise RuntimeError("no interface selected")
        self._ensure_monitor()
        seconds = int(self.cfg.get("scan_seconds") or DEFAULTS["scan_seconds"])
        targets = scan(iface, seconds, self.workdir / "captures", self.log)
        self.state.targets = filter_targets(targets, scope_regex(self.cfg))
        # preferred networks (BELL7 by default) come first; everything in
        # range is in scope, so all are selected by default (no BSSID typing)
        self.state.targets.sort(
            key=lambda t: (not is_preferred(t.essid, self.cfg), t.essid)
        )
        for t in self.state.targets:
            t.selected = True
        return self.state.targets

    def do_capture(self) -> None:
        targets = [t for t in self.state.targets if t.selected]
        if not targets:
            raise RuntimeError("no targets selected for capture")
        backend = str(self.cfg.get("capture_backend") or "wifite")
        session: Optional[MonitorSession] = None
        if backend == "hcxdumptool":
            # hcxdumptool sets monitor mode itself; the official guidance is
            # not to let a third party tool do it.
            log("monitor: hcxdumptool sets monitor mode itself")
        else:
            self._ensure_monitor()
            session = self._monitor
        try:
            if self.cfg.get("randomize_mac"):
                randomize_mac(session.interface if session else
                              str(self.cfg.get("interface") or ""), self.log)
            pcapng, captured = capture_pmkids(
                targets, self.cfg, self.workdir, self.log
            )
            self._pcapng = pcapng
        finally:
            if session and session is not self._monitor:
                session.cleanup(self.log)

    def do_convert_filter(self) -> None:
        bell, entries = convert_and_filter(
            self.cfg,
            self.workdir,
            self.log,
            self._pcapng,
            sorted((self.workdir / "hs").glob("*.22000")),
            [t for t in self.state.targets if t.selected],
        )
        self.state.entries = entries
        if bell:
            self.cfg.set("_bell_hashes", str(bell))

    def do_plan(self) -> List[Step]:
        bell = Path(self.cfg.get("_bell_hashes") or self.workdir / "bell.22000")
        if not self.state.entries and bell.exists():
            self.state.entries = load_22000(bell)
            self.log(f"plan: loaded {len(self.state.entries)} hash(es) from {bell}")
        speed = detect_speed(self.cfg, self.workdir, self.log)
        plan = build_plan(self.state.entries, self.cfg, bell, speed,
                          self.workdir / "masks")

        # Candidate wordlists run after the mask chain, as requested.
        candidates = build_candidate_wordlists(
            self.state.entries, self.cfg, self.workdir, self._pcapng, self.log
        )
        labels = {
            "derived": "SSID-derived candidates",
            "rules": "rule-expanded candidates",
            "hcxeiutool": "hcxeiutool ESSID patterns",
            "hcxpsktool": "hcxpsktool weak-PSK candidates",
            "wordlist": "configured wordlist",
        }
        for key, label in labels.items():
            path = candidates.get(key)
            if not path:
                continue
            try:
                count = count_lines(path)
            except OSError:
                count = 0
            if not count:
                continue
            step = Step(
                name=f"wordlist:{key}",
                kind="wordlist",
                desc=f"{label}: {count} candidates from {path.name}",
                group="candidates",
                keyspace=count,
                wordlist=path,
                hashes=bell,
            )
            if speed and speed > 0:
                step.est_seconds = count / speed
            plan.append(step)

        self.state.plan = plan
        for step in self.state.plan:
            self.state.step_state.setdefault(step.name, "pending")
        return self.state.plan

    def do_attack(self) -> None:
        if not self.state.plan:
            self.do_plan()
        force = hashcat_needs_force(self.log)
        budget_raw = self.cfg.get("max_hours_per_step")
        budget = (float(budget_raw) * 3600.0) if budget_raw else 0.0
        for step in self.state.plan:
            if self._stopped():
                break
            if (
                budget > 0
                and step.est_seconds
                and step.est_seconds > budget
                and not self.cfg.get("allow_huge_keyspace")
            ):
                step.skip_reason = (
                    f"ETA {human_time(step.est_seconds)} exceeds the "
                    f"{human_time(budget)} budget (raise --max-hours or enable "
                    f"huge keyspaces)"
                )
            self.state.step_state[step.name] = "running"
            self.state.step_detail[step.name] = step.desc
            result = run_step(step, self.cfg, self.workdir, self.log, self.potfile,
                              force)
            self.state.results.append(result)
            self.state.step_state[step.name] = result.status
            self.state.step_detail[step.name] = result.detail or step.desc
            if result.log_path:
                self.state.current_log = result.log_path.read_text(
                    encoding="utf-8", errors="replace"
                ).splitlines()[-40:]
        if self.state.results:
            cracked = show_cracked(
                Path(self.cfg.get("_bell_hashes") or self.workdir / "bell.22000"),
                self.potfile,
            )
            for result in self.state.results:
                result.cracked = list(cracked)

    def do_report(self) -> Dict[str, Any]:
        bell = Path(self.cfg.get("_bell_hashes") or self.workdir / "bell.22000")
        self.state.payload = write_report(
            self.workdir, self.state.entries, self.state.results,
            self.state.plan, self.log,
        )
        return self.state.payload

    def run(self, phases: Sequence[str]) -> Dict[str, Any]:
        total = len(phases)
        try:
            for index, phase in enumerate(phases, start=1):
                if self._stopped():
                    break
                try:
                    if phase == "preflight":
                        self._phase("preflight", total, index, "checking toolchain")
                        self.preflight()
                    elif phase == "scan":
                        self._phase("scan", total, index, "enumerating access points")
                        self.do_scan()
                    elif phase == "capture":
                        self._phase("capture", total, index, "collecting PMKIDs")
                        self.do_capture()
                    elif phase == "convert":
                        self._phase("convert", total, index, "converting to hc22000")
                    elif phase == "filter":
                        self._phase("filter", total, index, "filtering to the scope")
                        self.do_convert_filter()
                    elif phase == "plan":
                        self._phase("plan", total, index, "building the attack chain")
                        self.do_plan()
                    elif phase == "attack":
                        self._phase("attack", total, index, "running the chain")
                        self.do_attack()
                    elif phase == "report":
                        self._phase("report", total, index, "writing the report")
                        self.do_report()
                except Exception as exc:  # surfaced in the TUI and the CLI
                    # one phase failing must not skip the phases after it,
                    # the report in particular
                    self.state.error = f"{phase}: {type(exc).__name__}: {exc}"
                    self.log(f"error in phase {phase}: {exc}", "error")
        finally:
            if self._monitor:
                self._monitor.cleanup(self.log)
                self._monitor = None
            self.state.done = True
        return self.state.payload


