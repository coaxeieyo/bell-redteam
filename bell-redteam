                for i, iface in enumerate(self.interfaces):
                    selected = i == self.idx
                    attr = curses.color_pair(2) | curses.A_BOLD if selected else 0
                    marker = ">" if selected else " "
                    form = "virtual" if iface.virtual else "physical"
                    drv = adapter_driver(iface.name) or "-"
                    line = (
                        f" {marker} {i:>2}  {iface.name:<12} {iface.kind:<10} "
                        f"{form:<9} {iface.mac:<18} {drv:<12} {iface.phy:<6} "
                        f"{str(iface.channel or '-'):<4} "
                        f"{'yes' if monitor_capable(iface) else 'no'}"
                    )
                    self._put(stdscr, row + 2 + i, 2, line, attr)
            note = row + 2 + len(self.interfaces) + 2
            self._put(stdscr, note, 2,
                      "Ralink USB adapters (rt2800usb) are listed first and "
                      "selected by default.", curses.color_pair(3))
            self._put(stdscr, note + 1, 2,
                      "hcxdumptool guidance: avoid virtual monitor interfaces "
                      "(wlanmon0/mon1) and let it set",
                      curses.color_pair(6))
            self._put(stdscr, note + 2, 2,
                      "monitor mode itself. The 'physical' strategy below does "
                      "exactly that.", curses.color_pair(6))
            self._footer(stdscr, "[Up/Down] select   [Enter] choose   "
                                "[r] rescan   [q] quit")
            stdscr.refresh()
            key = stdscr.getch()
            if key in (ord("q"), ord("Q")):
                return "quit"
            if key in (ord("r"), ord("R")):
                self.interfaces = list_interfaces()
                preferred = preferred_interface(self.interfaces)
                self.idx = self.interfaces.index(preferred) if preferred else 0
                continue
            if key in (curses.KEY_DOWN, ord("j")):
                self.idx = min(self.idx + 1, max(0, len(self.interfaces) - 1))
            elif key in (curses.KEY_UP, ord("k")):
                self.idx = max(0, self.idx - 1)
            elif key in (10, 13, curses.KEY_ENTER):
                if not self.interfaces:
                    continue
                chosen = self.interfaces[self.idx]
                self.cfg.set("interface", chosen.name)
                self.status = f"interface {chosen.name} selected"
                return "config"

