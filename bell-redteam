@dataclass
class HashEntry:
    raw: str
    mtype: str
    essid: str
    bssid: str
    sta: str
    pmkid: str = ""

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


def _hex_to_text(value: str) -> str:
    if not value or len(value) % 2:
        return ""
    try:
        blob = bytes.fromhex(value)
    except ValueError:
        return ""
    try:
        return blob.decode("utf-8")
    except UnicodeDecodeError:
        return blob.decode("latin-1", errors="ignore")


def _text_to_hex(value: str) -> str:
    return value.encode("utf-8", errors="ignore").hex()


def parse_22000(line: str) -> Optional[HashEntry]:
    """Parse one hc22000 line.

    Canonical layout (hashcat wiki / hcxtools):
        WPA*01*PMKID*MAC_AP*MAC_CLIENT*ESSID***MESSAGEPAIR
        WPA*02*MIC*MAC_AP*MAC_CLIENT*ESSID*NONCE*EAPOL*MESSAGEPAIR
    ESSID sits at field index 5 in both. A tolerant fallback scans the
    fields for the first hex blob that decodes to a printable SSID.
    """
    line = line.strip()
    if not line or not line.startswith("WPA*"):
        return None
    fields = line.split("*")
    if len(fields) < 6:
        return None
    mtype = fields[1]
    if mtype not in HC22000_TYPES:
        return None

    essid = _hex_to_text(fields[5]) if len(fields) > 5 else ""
    bssid = fields[3].lower() if len(fields) > 3 else ""
    sta = fields[4].lower() if len(fields) > 4 else ""
    pmkid = fields[2].lower() if mtype == "01" and len(fields) > 2 else ""

    if not essid:
        for field in fields[2:]:
            candidate = _hex_to_text(field)
            if candidate and all(32 <= ord(ch) < 127 for ch in candidate):
                essid = candidate
                break

    if not essid:
        return None
    return HashEntry(
        raw=line, mtype=mtype, essid=essid, bssid=bssid, sta=sta, pmkid=pmkid
    )


def load_22000(path: Path) -> List[HashEntry]:
    entries: List[HashEntry] = []
    try:
        text = path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return entries
    for line in text.splitlines():
        if not line.strip():
            continue
        entry = parse_22000(line)
        if entry:
            entries.append(entry)
    return entries


def write_22000(path: Path, entries: Iterable[HashEntry]) -> int:
    path.parent.mkdir(parents=True, exist_ok=True)
    count = 0
    with path.open("w", encoding="utf-8") as fh:
        for entry in entries:
            fh.write(entry.raw.rstrip("\n") + "\n")
            count += 1
    return count


# --------------------------------------------------------------------------
# attack plan: mask chain + candidate wordlists
# --------------------------------------------------------------------------


@dataclass
class MaskVariant:
    label: str
    charsets: List[str]
    mask: str
    keyspace: int
    note: str = ""


@dataclass
class Step:
    name: str
    kind: str  # mask | wordlist
    desc: str
    group: str
    keyspace: int = 0
    est_seconds: Optional[float] = None
    charsets: List[str] = field(default_factory=list)
    mask: str = ""
    mask_file: Optional[Path] = None
    wordlist: Optional[Path] = None
    hashes: Optional[Path] = None
    skip_reason: str = ""

    @property
    def skippable(self) -> bool:
        return bool(self.skip_reason)

    def to_dict(self) -> Dict[str, Any]:
        d = asdict(self)
        d["wordlist"] = str(self.wordlist) if self.wordlist else None
        d["hashes"] = str(self.hashes) if self.hashes else None
        d["mask_file"] = str(self.mask_file) if self.mask_file else None
        d["est_seconds"] = self.est_seconds
        return d


def expand_charset(spec: str) -> str:
    """Expand a charset spec like 'Aa0-9' into the literal character set."""
    spec = (spec or "").strip()
    if not spec:
        return ""
    if spec.startswith("?") and len(spec) > 1:
        mapping = {
            "l": "abcdefghijklmnopqrstuvwxyz",
            "u": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
            "d": "0123456789",
            "s": " !\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~",
            "a": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789",
        }
        out = []
        for ch in spec[1:]:
            out.append(mapping.get(ch.lower(), ""))
        return "".join(out)

    # "A" -> A-Z, "a" -> a-z, "0" or any bare digit -> 0-9, "X-Y" -> a
    # literal range. "Aa0-9" and "Aa09" therefore both yield the 62
    # character alphanumeric set.
    classes = {
        "A": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
        "a": "abcdefghijklmnopqrstuvwxyz",
        "0": "0123456789",
    }
    out: List[str] = []
    i = 0
    while i < len(spec):
        ch = spec[i]
        if i + 2 < len(spec) and spec[i + 1] == "-":
            start, end = spec[i], spec[i + 2]
            out.extend(chr(c) for c in range(ord(start), ord(end) + 1))
            i += 3
            continue
        if ch.isdigit():
            out.append(classes["0"])
        else:
            out.append(classes.get(ch, ch))
        i += 1
    seen = set()
    unique = []
    for ch in out:
        if ch not in seen:
            seen.add(ch)
            unique.append(ch)
    return "".join(unique)


def _class_of(ch: str) -> str:
    if ch.isdigit():
        return "d"
    if ch.isupper():
        return "u"
    if ch.islower():
        return "l"
    return "o"


def _pow_size(charsets: Sequence[str], slots: Sequence[int]) -> int:
    """Keyspace of masked positions, each bound to a charset slot."""
    total = 1
    for slot in slots:
        if 1 <= slot <= len(charsets):
            total *= max(1, len(charsets[slot - 1]))
        else:
            total *= 1
    return total


def _slot_assignment(sets: Sequence[str]) -> Optional[List[int]]:
    """Map each position to a charset slot index.

    Returns None when more than HASHCAT_MAX_CHARSETS distinct charsets are
    needed (hashcat 6.2.6 provides only -1..-4).
    """
    distinct: List[str] = []
    for s in sets:
        if s not in distinct:
            distinct.append(s)
    if not distinct or len(distinct) > HASHCAT_MAX_CHARSETS:
        return None
    index = {cs: i + 1 for i, cs in enumerate(distinct)}
    return [index[s] for s in sets]


def build_mask_variants(
    prefix: str,
    mask_len: int,
    charset_spec: str,
    essids: Sequence[str],
) -> List[MaskVariant]:
    """Build the ordered mask chain for one ESSID length group.

    The mask length is the passphrase length (mask_len), not the ESSID
    length: a Bell SSID such as "BELL726" is 7 characters, but the WPA2 key
    is 8, and hashcat's WPA kernels refuse candidates shorter than 8. The
    ESSID contributes the charset evidence, the mask length comes from the
    configuration.

    Variants, narrowest first:
      1. position-exact  - per-position observed character sets
      2. position-class  - per-position observed character classes
      3. global-observed - union of every observed character
    The configured charsets (the requested masks) are added by the caller so
    they always appear in the chain.
    """
    variants: List[MaskVariant] = []
    if not essids:
        return variants

    length = len(essids[0])
    masked = mask_len - len(prefix)
    if masked < 1:
        return variants

    # The literal prefix is taken from the observed ESSIDs so that a
    # lowercase SSID such as "bell726" yields a lowercase literal too.
    observed_prefixes: List[str] = []
    for essid in essids:
        if essid[: len(prefix)].upper() == prefix.upper():
            literal = essid[: len(prefix)]
            if literal not in observed_prefixes:
                observed_prefixes.append(literal)
    if not observed_prefixes:
        observed_prefixes = [prefix]

    def class_chars(chars: str) -> str:
        out = ""
        for cl in ("d", "u", "l", "o"):
            if cl in {_class_of(c) for c in chars}:
                out += {
                    "d": "0123456789",
                    "u": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
                    "l": "abcdefghijklmnopqrstuvwxyz",
                    "o": "".join(sorted(c for c in chars if _class_of(c) == "o")),
                }[cl]
        return out

    def unique(seq: Iterable[str]) -> List[str]:
        out: List[str] = []
        for item in seq:
            if item not in out:
                out.append(item)
        return out

    for literal in observed_prefixes:
        tag = "" if literal == prefix else f":{literal}"
        per_position: List[str] = ["" for _ in range(masked)]
        for essid in essids:
            if essid[: len(prefix)].upper() != prefix.upper():
                continue
            suffix = essid[len(prefix) :]
            for i, ch in enumerate(suffix[:masked]):
                per_position[i] += ch

        per_position = ["".join(sorted(set(s))) for s in per_position]
        global_chars = "".join(
            sorted(set("".join(p for p in per_position if p)))
        )

        # 1. position-exact: usable when every masked position was observed
        if len(essids) >= 3 and all(per_position):
            slots = _slot_assignment(per_position)
            if slots:
                charsets = unique(per_position)
                mask = literal + "".join(f"?{slot}" for slot in slots)
                variants.append(
                    MaskVariant(
                        label=f"position-exact[{length}]{tag}",
                        charsets=charsets,
                        mask=mask,
                        keyspace=_pow_size(charsets, slots),
                        note="per-position charset from observed ESSID suffixes",
                    )
                )

        # 2. position-class: unobserved positions fall back to the global class
        class_sets: List[str] = []
        for observed in per_position:
            chars = (
                class_chars(observed) if observed else class_chars(global_chars)
            )
            class_sets.append(chars)
        slots = _slot_assignment(class_sets)
        if slots and all(class_sets):
            charsets = unique(class_sets)
            mask = literal + "".join(f"?{slot}" for slot in slots)
            variants.append(
                MaskVariant(
                    label=f"position-class[{length}]{tag}",
                    charsets=charsets,
                    mask=mask,
                    keyspace=_pow_size(charsets, slots),
                    note="per-position character classes (digits/upper/lower/other)",
                )
            )

        # 2b. position-hybrid: the exact observed set where a position was
        # seen, the character class where it was not. For "BELL" + 3 digits
        # and an 8 character passphrase this keeps the three digit
        # positions exact and completes the fourth with the digit class.
        hybrid_sets: List[str] = []
        for observed in per_position:
            if observed:
                hybrid_sets.append(observed)
            else:
                hybrid_sets.append(class_chars(global_chars))
        slots = _slot_assignment(hybrid_sets)
        if slots and all(hybrid_sets):
            charsets = unique(hybrid_sets)
            mask = literal + "".join(f"?{slot}" for slot in slots)
            variants.append(
                MaskVariant(
                    label=f"position-hybrid[{length}]{tag}",
                    charsets=charsets,
                    mask=mask,
                    keyspace=_pow_size(charsets, slots),
                    note="observed digits at their own positions, class elsewhere",
                )
            )

        # 3. global-observed
        if global_chars:
            mask = literal + ("?1" * masked)
            variants.append(
                MaskVariant(
                    label=f"global-observed[{length}]{tag}",
                    charsets=[global_chars],
                    mask=mask,
                    keyspace=len(global_chars) ** masked,
                    note="union of every character seen in this ESSID length group",
                )
            )
    return variants


def mask_file_line(charsets: Sequence[str], mask: str) -> str:
    """Render one hashcat mask file line.

    The format hashcat expects is a comma separated list whose last element
    is the mask and whose preceding elements are the custom charsets for
    ?1, ?2, ... (see the hashcat repository's masks/hashcat-default.hcmask).
    A comma inside a charset would break the line, so it is removed.
    """
    parts = [cs.replace(",", "") for cs in charsets if cs]
    return ",".join(parts + [mask])


def write_mask_file(path: Path, charsets: Sequence[str], mask: str) -> Path:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(mask_file_line(charsets, mask) + "\n", encoding="utf-8")
    return path


# --------------------------------------------------------------------------
# policy masks: the "intelligent rule" that removes the anti-candidates
# --------------------------------------------------------------------------

# A Bell WPA2 key is eight random characters over A-Z a-z 0-9, so it always
# contains at least one lower case letter, one upper case letter and one
# digit.  Requiring that removes the obvious anti-candidates
# (aaaaaaaa, ssssssss, 99999999, aaaaAAAA, 9999aaaa, ...) for free, before
# a single PBKDF2 iteration is spent on them.
#
# The same idea hashcat ships in masks/8char-1l-1u-1d-1s-compliant.hcmask:
# one mask line per class assignment, each line carrying its own charsets.
POLICY_CHARSETS: Dict[str, str] = {
    "d": "0123456789",
    "l": "abcdefghijklmnopqrstuvwxyz",
    "u": "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
}
POLICY_CLASSES = ("d", "l", "u")


def build_policy_mask_file(
    path: Path, length: int, classes: Sequence[str] = POLICY_CLASSES
) -> Tuple[int, int]:
    """Write the compliant policy mask file.

    Every line is "<charset1>,<charset2>,...,<mask>"; hashcat reads the
    comma separated list as the custom charsets with the mask last.  One
    line is emitted per class assignment that uses every class at least
    once, so the lines are disjoint and cover the compliant space exactly.

    Returns (number of masks, keyspace).
    """
    classes = tuple(classes)
    prefix = ",".join(POLICY_CHARSETS[c] for c in classes)
    slot = {c: f"?{i + 1}" for i, c in enumerate(classes)}

    combos: List[Tuple[str, Tuple[str, ...]]] = []
    keyspace = 0
    for combo in itertools.product(classes, repeat=length):
        if set(combo) != set(classes):
            continue
        mask = "".join(slot[c] for c in combo)
        size = 1
        for c in combo:
            size *= len(POLICY_CHARSETS[c])
        keyspace += size
        combos.append((mask, combo))

    # cheapest masks first: more digits means a smaller charset per position
    combos.sort(key=lambda item: (-sum(1 for c in item[1] if c == "d"), item[1]))

    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as fh:
        for mask, _ in combos:
            fh.write(f"{prefix},{mask}\n")
    return len(combos), keyspace


# --------------------------------------------------------------------------
# anti-candidate rules for the wordlist phase
# --------------------------------------------------------------------------

KEYBOARD_WALKS = (
    "qwertyuiop", "asdfghjkl", "zxcvbnm", "qwertzuiop", "asdfghjkl;",
    "1234567890", "0987654321", "1qaz2wsx", "2wsx3edc", "qazwsxedc",
    "1q2w3e4r", "zaq12wsx", "q1w2e3r4t5", "poiuytrewq", "mnbvcxzlkj",
)
COMMON_WORDS = (
    "password", "qwerty", "letmein", "welcome", "admin", "iloveyou",
    "sunshine", "princess", "football", "charlie", "monkey", "dragon",
    "abc123", "trustno1", "master", "shadow", "michael", "jennifer",
)


def _has_run(candidate: str, size: int) -> bool:
    """True when the candidate contains a run of `size` identical chars."""
    run = 1
    for i in range(1, len(candidate)):
        if candidate[i] == candidate[i - 1]:
            run += 1
            if run >= size:
                return True
        else:
            run = 1
    return False


def _has_sequence(candidate: str, size: int) -> bool:
    """True when the candidate contains an ascending or descending run."""
    run = 1
    for i in range(1, len(candidate)):
        delta = ord(candidate[i]) - ord(candidate[i - 1])
        if delta in (1, -1):
            run += 1
            if run >= size:
                return True
        else:
            run = 1
    return False


def anti_candidate_reasons(candidate: str) -> List[str]:
    """Structural anti-candidates that are never worth a PBKDF2 iteration.

    These are the patterns every password list already contains and that
    no device would ever ship as a random key.
    """
    reasons: List[str] = []
    if not candidate:
        return ["empty"]
    if len(set(candidate)) == 1:
        reasons.append("single-character")
    if _has_run(candidate, 4):
        reasons.append("four-character-run")
    for block in (2, 3, 4):
        if len(candidate) % block == 0 and len(candidate) > block:
            head = candidate[:block]
            if head * (len(candidate) // block) == candidate:
                reasons.append(f"repeated-{block}-block")
                break
    if _has_sequence(candidate, 4):
        reasons.append("character-sequence")
    lowered = candidate.lower()
    for walk in KEYBOARD_WALKS:
        if walk in lowered:
            reasons.append("keyboard-walk")
            break
    for word in COMMON_WORDS:
        if word in lowered:
            reasons.append("common-word")
            break
    return reasons


def filter_anti_candidates(
    candidates: Iterable[str], log: Optional[Log] = None
) -> Tuple[List[str], Dict[str, int]]:
    """Drop the anti-candidates, reporting how many of each were removed."""
    kept: List[str] = []
    seen = set()
    counts: Dict[str, int] = {}
    for candidate in candidates:
        if candidate in seen:
            continue
        seen.add(candidate)
        reasons = anti_candidate_reasons(candidate)
        if reasons:
            for reason in reasons:
                counts[reason] = counts.get(reason, 0) + 1
            continue
        kept.append(candidate)
    if log and counts:
        summary = ", ".join(f"{k}={v}" for k, v in sorted(counts.items()))
        log(f"candidates: filtered {sum(counts.values())} anti-candidate(s): "
            f"{summary}")
    return kept, counts


# --------------------------------------------------------------------------
# documented default router keyspaces
# --------------------------------------------------------------------------

# The default keys that ISPs print on the hardware are not random over the
# full alphabet, they are drawn from a restricted alphabet.  The canonical
# list is the RouterKeySpaceWordlists project by 3mrgnc3, which hashcat's
# own author (philsmd) quotes in the "Keyspace List for WPA on Default
# Routers" thread on the hashcat forum:
#
#     BELL###   - [0-9A-F] Len: 8
#     BELL####  - [0-9A-F] Len: 10
#
# A published recovery of a Bell Home Hub key (hack2know.how, 2019) shows
# the same alphabet in practice: the key was "A2F7F579" for the SSID
# "BELLXXX", eight upper case hexadecimal characters, cracked in two hours
# on a GTX 1050 with "-1 ?dABCDEF ?1?1?1?1?1?1?1?1".
#
# 16^8 = 4,294,967,296 is about 50,800 times smaller than the full 62^8
# alphanumeric space, which is what bridges the gap to a realistic attack.
BELL_KEYSPACES: Tuple[Tuple[str, str, int], ...] = (
    ("BELL###", "0-9A-F", 8),
    ("BELL####", "0-9A-F", 10),
)
BELL_REAL_KEY_EXAMPLE = "A2F7F579"
BELL_REAL_KEY_ESSID = "BELLXXX"

# Default keyspace profiles tried first, cheapest first.  These are literal
# character sets: the documented Bell generator alphabet and the two
# case variants of it, plus the pure numeric case.
#
# The reduced keyspace comes from a calexico post on the hashcat forum
# (2017-03-25, "Keyspace List for WPA on Default Routers"): on 275 Bell
# handshakes the full 16 character alphabet (16^8) cracked 210 of them,
# while a reduced 13 character alphabet (13^8) also cracked 210 of them.
# The omitted characters are 0, 8 and B, presumably for readability, since
# 0 looks like O and 8 like B.  The reduced alphabet is therefore tried
# first, before the full one.
# The reduced keyspace cannot be written as a charset spec because
# "1-9" would be read as a range, so it is a literal constant.
REDUCED_BELL_KEYSPACE = "12345679ACDEF"

KEYSPACE_CHARSETS = (
    "0123456789ABCDEF",    # 16 chars: the full documented Bell keyspace
    "0123456789abcdef",    # 16 chars: hex, lower case
    "0123456789ABCDEFabcdef",  # 32 chars: hex, mixed case
    "0123456789",          # 10 chars: digits only
)


def keyspace_profiles(cfg: Config) -> List[Tuple[str, str, str]]:
    """Return (name, literal charset, kind) triples for the mask chain.

    "keyspace" marks the restricted, documented generator alphabets and
    "alnum" the full alphanumeric fallback, which the "bell-first" order
    hoists to the front.
    """
    profiles: List[Tuple[str, str, str]] = []

    # The alphanumeric mask (Aa0-9) is the primary Bell attack and runs
    # first, as requested. The documented/reduced hex keyspaces follow.
    specs = cfg.get("mask_charsets") or []
    if isinstance(specs, str):
        specs = [specs]
    for spec in specs:
        charset = expand_charset(str(spec))
        if not charset:
            continue
        slug = re.sub(r"[^A-Za-z0-9]+", "", str(spec)) or "cs"
        if not any(c == charset for _, c, _ in profiles):
            profiles.append((slug, charset, "alnum"))

    profiles.append(("reduced-bell-13", REDUCED_BELL_KEYSPACE, "keyspace"))

    literal = cfg.get("keyspace_charsets")
    if isinstance(literal, str):
        literal = [literal]
    for charset in literal or list(KEYSPACE_CHARSETS):
        charset = str(charset)
        if not charset:
            continue
        slug = re.sub(r"[^A-Za-z0-9]+", "", charset) or "cs"
        if not any(c == charset for _, c, _ in profiles):
            profiles.append((slug, charset, "keyspace"))
    return profiles


def build_plan(
    entries: Sequence[HashEntry],
    cfg: Config,
    hashes_path: Path,
    speed: Optional[float],
    masks_dir: Optional[Path] = None,
) -> List[Step]:
    """Build the ordered attack chain for the captured BELL hashes."""
    prefix = str(cfg.get("ssid_prefix") or "BELL")
    mask_len = int(cfg.get("mask_len") or 8)
    charset = expand_charset(str(cfg.get("mask_charset") or "Aa0-9"))
    order = str(cfg.get("mask_order") or "effective")

    # Group the targets by length, but keep the preferred set (BELL7 by
    # default) in front so its masks and candidates are tried first.
    groups: Dict[Tuple[bool, int], List[str]] = {}
    for entry in entries:
        key = (is_preferred(entry.essid, cfg), len(entry.essid))
        groups.setdefault(key, []).append(entry.essid)
    by_length = {length: names for (_, length), names in groups.items()}
    ordered_groups = [
        names
        for _, names in sorted(
            groups.items(), key=lambda kv: (not kv[0][0], kv[0][1])
        )
    ]

    steps: List[Step] = []

    # The requested charsets. Only the free shape is used by default: the
    # key is random, it does not start with the SSID prefix, and the policy
    # mask file below covers the whole alphanumeric space with the
    # anti-candidates removed.
    use_prefix = bool(cfg.get("mask_prefix", True)) and bool(
        cfg.get("include_prefixed", False)
    )
    tail = mask_len - len(prefix)
    for slug, spec_chars, kind in keyspace_profiles(cfg):
        if not spec_chars:
            continue
        shapes: List[Tuple[str, str, int, str]] = []
        if use_prefix and prefix and tail >= 1:
            shapes.append(
                (
                    "prefixed",
                    prefix + ("?1" * tail),
                    len(spec_chars) ** tail,
                    f"{prefix} + {tail} characters",
                )
            )
        if use_prefix and prefix:
            shapes.append(
                (
                    "prefixed-full",
                    prefix + ("?1" * mask_len),
                    len(spec_chars) ** mask_len,
                    f"{prefix} + {mask_len} characters",
                )
            )
        shapes.append(
            (
                "free",
                "".join(["?1"] * mask_len),
                len(spec_chars) ** mask_len,
                f"{mask_len} free characters",
            )
        )
        for shape, mask, keyspace, description in shapes:
            if len(mask) - mask.count("?") < PSK_MIN_LEN:
                continue
            if any(s.mask == mask and s.charsets == [spec_chars] for s in steps):
                continue
            steps.append(
                Step(
                    name=f"mask:requested-{mask_len}-{slug}-{shape}",
                    kind="mask",
                    desc=(
                        f"requested {description} with charset {spec_chars}: "
                        f"'{mask}'"
                    ),
                    group=kind,
                    keyspace=keyspace,
                    charsets=[spec_chars],
                    mask=mask,
                    hashes=hashes_path,
                )
            )

    for essid_list in ordered_groups:
        essids = sorted(set(essid_list))
        length = len(essids[0])
        group = f"len{length}"
        if is_preferred(essids[0], cfg):
            group += "-preferred"
        if not cfg.get("include_evidence_masks", False):
            continue
        for variant in build_mask_variants(prefix, mask_len, charset, essids):
            if len(variant.mask) < PSK_MIN_LEN:
                continue
            steps.append(
                Step(
                    name=f"mask:{variant.label}",
                    kind="mask",
                    desc=(
                        f"{variant.label}: {variant.note}; mask '{variant.mask}' "
                        f"over {len(essids)} ESSID(s)"
                    ),
                    group=group,
                    keyspace=variant.keyspace,
                    charsets=list(variant.charsets),
                    mask=variant.mask,
                    hashes=hashes_path,
                )
            )

    # The policy mask file: eight random characters with at least one lower
    # case letter, one upper case letter and one digit. This is the step
    # that removes the anti-candidates (aaaaaaaa, ssssssss, 99999999,
    # aaaaAAAA, 9999aaaa, ...) before they ever cost a PBKDF2 iteration.
    policy_masks = 0
    policy_keyspace = 0
    if cfg.get("policy_masks", True) and masks_dir:
        policy_file = masks_dir / "policy-8char-1l-1u-1d.hcmask"
        policy_masks, policy_keyspace = build_policy_mask_file(
            policy_file, mask_len
        )
        steps.append(
            Step(
                name=f"mask:policy-{mask_len}char-1l-1u-1d",
                kind="mask",
                desc=(
                    f"policy mask file: {policy_masks} masks over "
                    f"{mask_len} characters, at least one lower case letter, "
                    f"one upper case letter and one digit; anti-candidates "
                    f"such as aaaaaaaa, ssssssss, 99999999, aaaaAAAA and "
                    f"9999aaaa are excluded by construction"
                ),
                group="policy",
                keyspace=policy_keyspace,
                mask_file=policy_file,
                hashes=hashes_path,
            )
        )

    if order in ("bell-first", "requested"):
        # the full alphanumeric mask first, as requested, then everything
        # else cheapest first
        alnum = [s for s in steps if s.group == "alnum"]
        rest = [s for s in steps if s.group != "alnum"]
        rest.sort(key=lambda s: (s.keyspace or 0))
        steps = alnum + rest
    else:
        steps.sort(key=lambda s: (s.keyspace or 0))

    if masks_dir:
        for step in steps:
            if step.kind != "mask" or not step.mask:
                continue
            safe = re.sub(r"[^A-Za-z0-9_.-]+", "_", step.name)
            step.mask_file = write_mask_file(
                masks_dir / f"{safe}.hcmask", step.charsets, step.mask
            )

    for step in steps:
        if speed and speed > 0 and step.keyspace:
            step.est_seconds = step.keyspace / speed
    return steps


