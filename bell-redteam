class Log:
    """Line logger that writes to stderr and to a rolling log file."""

    def __init__(self, path: Optional[Path] = None) -> None:
        self.path = path
        self.lines: List[str] = []
        self._lock = threading.Lock()
        self.quiet = False
        if path:
            path.parent.mkdir(parents=True, exist_ok=True)

    def __call__(self, msg: str, level: str = "info") -> None:
        stamp = time.strftime("%H:%M:%S")
        text = f"[{stamp}] {msg}"
        with self._lock:
            self.lines.append(text)
            if len(self.lines) > 5000:
                self.lines = self.lines[-2500:]
            if self.path:
                try:
                    with self.path.open("a", encoding="utf-8") as fh:
                        fh.write(text + "\n")
                except OSError:
                    pass
        if not self.quiet:
            sys.stderr.write(text + "\n")
            sys.stderr.flush()

    def tail(self, n: int = 20) -> List[str]:
        with self._lock:
            return self.lines[-n:]


def which(name: str) -> Optional[str]:
    found = shutil.which(name)
    if found:
        return found
    for d in ("/usr/local/sbin", "/usr/local/bin", "/usr/sbin", "/usr/bin",
              "/sbin", "/bin"):
        cand = os.path.join(d, name)
        if os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def have(name: str) -> bool:
    return which(name) is not None


def run(
    cmd: Sequence[str],
    timeout: Optional[float] = None,
    cwd: Optional[Path] = None,
    check: bool = False,
    env: Optional[Dict[str, str]] = None,
) -> subprocess.CompletedProcess:
    """Run a command, never raising on non-zero unless check=True."""
    merged = dict(os.environ)
    if env:
        merged.update(env)
    try:
        proc = subprocess.run(
            list(cmd),
            timeout=timeout,
            cwd=str(cwd) if cwd else None,
            capture_output=True,
            text=True,
            env=merged,
            check=check,
            stdin=subprocess.DEVNULL,
            start_new_session=True,
        )
    except subprocess.TimeoutExpired as exc:
        return subprocess.CompletedProcess(
            list(cmd), 124, exc.stdout or "", (exc.stderr or "") + "\n[timeout]"
        )
    except FileNotFoundError as exc:
        return subprocess.CompletedProcess(list(cmd), 127, "", str(exc))
    except OSError as exc:
        return subprocess.CompletedProcess(list(cmd), 126, "", str(exc))
    return proc


def human_time(seconds: Optional[float]) -> str:
    if seconds is None:
        return "-"
    seconds = float(seconds)
    if seconds < 0:
        return "-"
    if seconds < 1:
        return f"{seconds:.2f}s"
    for unit, div in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= div:
            value = seconds / div
            return f"{value:.1f}{unit}"
    return f"{seconds:.0f}s"


def human_count(n: float) -> str:
    for unit, div in (
        ("E", 1e18),
        ("P", 1e15),
        ("T", 1e12),
        ("G", 1e9),
        ("M", 1e6),
        ("K", 1e3),
    ):
        if abs(n) >= div:
            return f"{n / div:.3g}{unit}"
    return f"{n:.0f}"


def parse_bytes(text: str) -> Optional[int]:
    m = re.search(r"(\d+)\s*([KMGT]?)i?B", text, re.IGNORECASE)
    if not m:
        return None
    mult = {"": 1, "K": 1024, "M": 1024**2, "G": 1024**3, "T": 1024**4}
    return int(m.group(1)) * mult.get(m.group(2).upper(), 1)


def safe_int(value: str, default: int) -> int:
    try:
        return int(str(value).strip())
    except (TypeError, ValueError):
        return default


def safe_float(value: str, default: float) -> float:
    try:
        return float(str(value).strip())
    except (TypeError, ValueError):
        return default


def read_json(path: Path, default: Any) -> Any:
    try:
        with path.open("r", encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def count_lines(path: Path) -> int:
    """Count lines in a possibly non-UTF-8 candidate list."""
    try:
        with path.open("rb") as fh:
            return sum(1 for _ in fh)
    except OSError:
        return 0


def read_lines_text(path: Path) -> List[str]:
    """Read a candidate list as text, tolerating non-UTF-8 bytes.

    Split on lines, never on whitespace: a passphrase may contain spaces
    and must survive as one candidate.
    """
    try:
        with path.open("r", encoding="utf-8", errors="replace") as fh:
            return fh.read().splitlines()
    except OSError:
        return []


def write_json(path: Path, payload: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w", encoding="utf-8") as fh:
        json.dump(payload, fh, indent=2, sort_keys=True, default=str)
        fh.flush()
        os.fsync(fh.fileno())
    tmp.replace(path)


