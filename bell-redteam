@dataclass
class Target:
    essid: str
    bssid: str
    channel: Optional[int] = None
    encr: str = ""
    signal: int = -100
    length: int = 0
    selected: bool = False

    def to_dict(self) -> Dict[str, Any]:
        return asdict(self)


def _norm_essid(raw: str) -> str:
    return raw.replace("\x00", "").strip()


def parse_airodump_csv(path: Path) -> List[Target]:
    """Parse the 'Parsed Airodump-ng capture file' CSV.

    The header written by airodump-ng is:

        BSSID, First time seen, Last time seen, channel, Speed, Privacy,
        Cipher, Authentication, Power, # beacons, # IV, LAN IP, ID-length,
        ESSID, Key

    so the ESSID is column 13, the channel column 3 and the signal
    ("Power") column 8.  Station rows use a different header and are
    skipped.
    """
    targets: List[Target] = []
    try:
        with path.open("r", encoding="utf-8", errors="replace", newline="") as fh:
            reader = csv.reader(fh)
            rows = list(reader)
    except OSError:
        return targets

    for row in rows:
        if len(row) < 14:
            continue
        mac = row[0].strip()
        if not re.fullmatch(r"[0-9A-Fa-f]{2}(:[0-9A-Fa-f]{2}){5}", mac):
            continue
        # airodump-ng's -01.csv layout (upstream dump_write.c):
        #   0 BSSID, 1 First time seen, 2 Last time seen, 3 channel,
        #   4 Speed, 5 Privacy, 6 Cipher, 7 Authentication, 8 Power,
        #   9 # beacons, 10 # IV, 11 LAN IP, 12 ID-length, 13 ESSID, 14 Key
        essid = _norm_essid(row[13])
        if not essid:
            continue
        targets.append(
            Target(
                essid=essid,
                bssid=mac.lower(),
                channel=safe_int(row[3], 0) or None,
                encr=f"{row[5].strip()} {row[6].strip()}",
                signal=safe_int(row[8], -100),
                length=safe_int(row[12], 0),
            )
        )
    return targets


def _verify_monitor_mode(iface: str, log: Log) -> bool:
    """Check that the interface is in monitor mode; log and return False if not."""
    proc = run(["iw", "dev", iface, "info"], timeout=15)
    if proc.returncode != 0:
        log(f"scan: could not read interface {iface} state", "warn")
        return False
    if re.search(r"type\s+monitor\b", proc.stdout):
        return True
    log(f"scan: {iface} is not in monitor mode; airodump-ng may produce empty results", "warn")
    return False


def scan(
    iface: str,
    seconds: int,
    outdir: Path,
    log: Log,
    channel: Optional[int] = None,
) -> List[Target]:
    """Run airodump-ng for `seconds`, then flush and parse its CSV."""
    seconds = max(60, int(seconds or 0))
    outdir.mkdir(parents=True, exist_ok=True)
    _verify_monitor_mode(iface, log)
    prefix = outdir / f"scan_{int(time.time())}"
    cmd = ["airodump-ng", iface, "-w", str(prefix)]
    if channel:
        cmd += ["-c", str(channel)]
    log(f"scan: {' '.join(shlex.quote(c) for c in cmd)} ({seconds}s)")
    if not _verify_monitor_mode(iface, log):
        log("scan: continuing anyway - results may be empty", "warn")
    proc = subprocess.Popen(
        cmd,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        cwd=str(outdir),
        start_new_session=True,
    )
    try:
        time.sleep(max(1, seconds))
    finally:
        proc.send_signal(signal.SIGINT)
        try:
            proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=5)

    stderr_output = proc.stderr.read().decode("utf-8", errors="replace") if proc.stderr else ""

    csv_path = Path(f"{prefix}-01.csv")
    if not csv_path.exists():
        matches = sorted(outdir.glob(f"{prefix.name}*.csv"))
        csv_path = matches[0] if matches else csv_path
    targets = parse_airodump_csv(csv_path) if csv_path.exists() else []
    log(f"scan: {len(targets)} access points observed")
    if not targets:
        if stderr_output:
            log(f"scan: airodump-ng said: {stderr_output[-400:]}", "warn")
        else:
            log("scan: no access points observed. If you are using an "
                "internal adapter, try a Ralink/TP-Link USB adapter in "
                "monitor mode.", "warn")
    return targets


def scope_regex(cfg: Config) -> str:
    """The in-scope filter, chosen from a preset so nothing has to be typed."""
    preset = str(cfg.get("scope_preset") or "all")
    if preset == "all":
        return ".*"
    if preset == "bell7":
        return "^BELL7..$"
    if preset == "bell":
        return "^BELL"
    return str(cfg.get("essid_regex") or "^BELL")


def is_preferred(essid: str, cfg: Config) -> bool:
    """True when the ESSID belongs to the preferred set (BELL7 by default)."""
    pattern = str(cfg.get("preferred_regex") or "")
    if not pattern:
        return False
    try:
        return re.search(pattern, essid, re.IGNORECASE) is not None
    except re.error:
        return False


def filter_targets(
    targets: Iterable[Target], pattern: str
) -> List[Target]:
    """Keep targets whose ESSID matches `pattern` (regex, case-insensitive)."""
    try:
        rx = re.compile(pattern, re.IGNORECASE)
    except re.error as exc:
        raise ValueError(f"invalid essid_regex {pattern!r}: {exc}") from exc
    out = [t for t in targets if rx.search(t.essid)]
    seen = set()
    unique = []
    for t in out:
        key = (t.essid, t.bssid)
        if key in seen:
            continue
        seen.add(key)
        unique.append(t)
    return unique


